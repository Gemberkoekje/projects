@page
@model NieuwModel
@{
    ViewData["Title"] = "Nieuwe prikker";

    void Rij(string index, OptionInput option)
    {
        <div class="optie-rij" data-optie>
            <label>Dag <input type="date" name="Input.Options[@index].Date" value="@option.Date" /></label>
            <label>Van <input type="time" name="Input.Options[@index].Start" value="@option.Start" /></label>
            <label>Tot <input type="time" name="Input.Options[@index].End" value="@option.End" /></label>
            <button type="button" class="knop-icoon" data-verwijder aria-label="Verwijder deze datum">&times;</button>
        </div>
    }
}

<section class="kaart">
    <h1>Nieuwe prikker</h1>
    <partial name="_Fouten" model="ModelState" />

    <form method="post" class="formulier">
        <label>Waar gaat het over?
            <input asp-for="Input.Title" maxlength="@Poll.MaxTitleLength" required placeholder="Etentje met de buren" />
        </label>
        <label>Waar? <span class="zacht">(optioneel)</span>
            <input asp-for="Input.Location" maxlength="@Poll.MaxLocationLength" />
        </label>
        <label>Toelichting <span class="zacht">(optioneel)</span>
            <textarea asp-for="Input.Description" rows="3" maxlength="@Poll.MaxDescriptionLength"></textarea>
        </label>

        <fieldset class="opties">
            <legend>Welke datums stel je voor?</legend>
            <p class="zacht">Laat de tijden leeg voor de hele dag. Lege rijen tellen niet mee.</p>
            <div data-opties>
                @for (var i = 0; i < Model.Input.Options.Count; i++)
                {
                    Rij(i.ToString(System.Globalization.CultureInfo.InvariantCulture), Model.Input.Options[i]);
                }
            </div>
            <template id="optie-sjabloon">
                @{ Rij("__i__", new OptionInput()); }
            </template>
            <button type="button" class="knop knop-licht" data-voeg-toe>+ Nog een datum</button>
        </fieldset>

        <button type="submit" class="knop knop-groot">Prikker maken</button>
    </form>
</section>
