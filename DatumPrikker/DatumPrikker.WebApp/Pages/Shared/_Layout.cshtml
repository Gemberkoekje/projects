@inject Admins Admins
@inject DatumPrikker.application.Queries.CountPendingRequestsHandler PendingRequests
@{
    var account = AccountClaims.From(User);
    var isAdmin = Admins.Includes(account);

    // Only admins cost a query (D17); everybody else gets 0 straight away.
    var pending = isAdmin ? await PendingRequests.HandleAsync(new DatumPrikker.application.Queries.CountPendingRequests { By = account }) : 0;
}
<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@(ViewData["Title"] is string title ? $"{title} · DatumPrikker" : "DatumPrikker")</title>
    <meta name="theme-color" content="#fff7ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#15122e" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="kop">
        <a class="merk" href="/" aria-label="DatumPrikker, naar de voorpagina">
            <svg class="merk-icoon" viewBox="0 0 32 32" aria-hidden="true">
                <rect class="vel" x="3" y="6" width="24" height="23" rx="5" stroke-width="2.5" />
                <path d="M3 13V11a5 5 0 0 1 5-5h14a5 5 0 0 1 5 5v2z" fill="#ff5c7a" class="rand" stroke-width="2.5" stroke-linejoin="round" />
                <rect x="8" y="17" width="4" height="4" rx="1" fill="#23a866" />
                <rect x="14" y="17" width="4" height="4" rx="1" fill="#e8960c" />
                <rect x="8" y="23" width="4" height="3" rx="1" fill="#e83d62" />
                <line x1="20" y1="25" x2="26.5" y2="31" class="rand" stroke-width="2.5" stroke-linecap="round" />
                <circle cx="24" cy="20" r="5" fill="#6c3bff" class="rand" stroke-width="2.5" />
            </svg>
            <span>Datum<b>Prikker</b></span>
        </a>
        <nav class="kop-nav">
            @if (account.IsAnonymous)
            {
                <a class="knop knop-licht" href="/Aanmelden?ReturnUrl=@Uri.EscapeDataString(Context.Request.Path + Context.Request.QueryString)">Inloggen</a>
            }
            else
            {
                @if (isAdmin)
                {
                    <a class="knop knop-licht" href="/Beheer" title="@(pending == 1 ? "1 aanvraag wacht" : $"{pending} aanvragen wachten")">Beheer@if (pending > 0) {<span class="teller" aria-label="@pending wachtend">@pending</span>}</a>
                }
                <a class="knop knop-licht" href="/Afspraken">Mijn afspraken</a>
                @* asp-page, not action=: only then does the form tag helper add the antiforgery token. *@
                <form method="post" asp-page="/Afmelden" class="inline">
                    <button type="submit" class="knop knop-licht" title="Ingelogd als @account.Name">Uitloggen</button>
                </form>
            }
        </nav>
    </header>
    <main class="inhoud">
        @RenderBody()
    </main>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
