@page "/p/{token}"
@model DatumPrikker.WebApp.Pages.P.PrikkenModel
@{
    ViewData["Title"] = Model.Poll.Title;
    var anoniem = Model.Account.IsAnonymous;
}

<section class="kaart poll-kop">
    <span class="eigenaar">@Model.Poll.OwnerName wil een datum prikken</span>
    <h1>@Model.Poll.Title</h1>
    @if (Model.Poll.Location.Length > 0)
    {
        <p class="waar">📍 @Model.Poll.Location</p>
    }
    @if (Model.Poll.Description.Length > 0)
    {
        <p class="toelichting">@Model.Poll.Description</p>
    }
</section>

@if (Model.Bedankt)
{
    <div class="melding melding-goed" role="status" data-feest>
        <strong>Dank je!</strong> Je antwoord is opgeslagen.
        @if (anoniem)
        {
            <span>Bewaar deze afspraak in je overzicht: <a href="@PrikkenModel.LoginToAppointmentsUrl">log in</a>, met hetzelfde e-mailadres.</span>
        }
        else
        {
            <span>Je vindt hem terug onder <a href="/Afspraken">Mijn afspraken</a>.</span>
        }
    </div>
}

@if (!Model.Poll.IsOpen)
{
    <div class="melding">Deze prikker is gesloten en neemt geen antwoorden meer aan.</div>
}
else
{
    @if (anoniem && Model.Remembered.IsNobody)
    {
        <p class="duwtje">
            <a href="@Model.LoginUrl">Log in</a>, dan vullen we je gegevens in en zie je al je afspraken op één plek. Hoeft niet: antwoorden kan ook zo.
        </p>
    }

    @if (anoniem && !Model.Remembered.IsNobody)
    {
        <form method="post" asp-page-handler="Vergeten" class="duwtje">
            Ingevuld voor @Model.Remembered.Name (@Model.Remembered.Email). Niet jij?
            <button type="submit" class="knop-link">Begin met een leeg formulier</button>
        </form>
    }

    @if (Model.HasEarlier && !Model.Bedankt)
    {
        <div class="melding" role="status">
            Je antwoordde al op @Weergave.Moment(Model.Earlier.UpdatedOn). Pas je antwoord hieronder aan en verstuur het opnieuw.
            @if (anoniem && Model.Earlier.IsClaimed)
            {
                <span class="blok"><strong>Dit antwoord gaf je terwijl je was ingelogd.</strong> <a href="@Model.LoginUrl">Log in</a> om het te wijzigen.</span>
            }
        </div>
    }

    <form method="post" class="kaart formulier">
        <partial name="_Fouten" model="ModelState" />

        <fieldset class="keuzes">
            <legend>Wanneer kun je?</legend>
            <p class="zacht hint">Kies per datum ja, misschien of nee.</p>
            <div class="rijen">
                @foreach (var option in Model.Poll.Options)
                {
                    var gekozen = Model.Chosen(option.Id);
                    <div class="keuze-rij">
                        <div class="keuze-datum">
                            <span class="mini-kalender" aria-hidden="true"><span>@Weergave.Maand(option.Date)</span><b>@Weergave.DagNummer(option.Date)</b></span>
                            <div>
                                <strong>@Weergave.Weekdag(option.Date)</strong>
                                <span class="zacht">@Weergave.Tijd(option)</span>
                            </div>
                        </div>
                        <div class="keuze-knoppen" role="radiogroup" aria-label="@Weergave.DagLang(option), @Weergave.Tijd(option)">
                            @foreach (var keuze in Weergave.Keuzes)
                            {
                                <label class="keuze keuze-@Weergave.Klasse(keuze)">
                                    <input type="radio" name="Input.Choices[@option.Id]" value="@keuze" checked="@(gekozen == keuze)" />
                                    <span>@Weergave.Woord(keuze)</span>
                                </label>
                            }
                        </div>
                    </div>
                }
            </div>
        </fieldset>

        <label>Je naam
            <input asp-for="Input.Name" autocomplete="name" maxlength="@Answer.MaxNameLength" required />
        </label>
        <label>Je e-mailadres
            <input asp-for="Input.Email" type="email" autocomplete="email" required readonly="@(Model.Account.Email.Length > 0)" />
        </label>
        <p class="zacht">
            @if (Model.Account.Email.Length > 0)
            {
                <span>Je antwoordt met het e-mailadres van je account.</span>
            }
            else
            {
                <span>Met hetzelfde adres kun je je antwoord later wijzigen.</span>
            }
            Alleen de maker ziet je e-mailadres.
        </p>
        <label>Opmerking <span class="zacht">(optioneel)</span>
            <textarea asp-for="Input.Comment" rows="2" maxlength="@Answer.MaxCommentLength"></textarea>
        </label>

        <button type="submit" class="knop knop-groot">@(Model.HasEarlier ? "Antwoord bijwerken" : "Antwoord versturen")</button>
    </form>
}
