@page "/p/{token}/uitslag"
@model DatumPrikker.WebApp.Pages.P.UitslagModel
@{
    var poll = Model.Results.Poll;
    var total = Model.Results.Answers.Count;
    var best = Model.Results.Best.Select(tally => tally.Option.Id).ToHashSet();

    // D22: only the owner picks, changes or undoes; an admin looking on gets no buttons (D18).
    var kiest = Model.IsOwner;
    ViewData["Title"] = Model.Refusal.Length > 0 ? "Uitslag" : $"Uitslag: {poll.Title}";
}

@if (Model.Refusal.Length > 0)
{
    <section class="kaart smal">
        <h1>Uitslag</h1>
        <p>@Model.Refusal</p>
        <p><a class="knop" href="/">Naar de voorpagina</a></p>
    </section>
}
else
{
    @if (Model.Nieuw)
    {
        <div class="melding melding-goed" role="status" data-feest><strong>Je prikker staat klaar!</strong> Deel de link hieronder met iedereen die mag antwoorden.</div>
    }

    @if (Model.Gekozen && poll.HasPick)
    {
        <div class="melding melding-goed" role="status"><strong>Gekozen!</strong> De prikker is gesloten. Iedereen met de link ziet nu @Weergave.DagMaand(poll.PickedOption().Date).</div>
    }

    @if (Model.Ongedaan && !poll.HasPick)
    {
        <div class="melding" role="status">De keuze is ongedaan gemaakt. De prikker blijft gesloten; kies hieronder een andere datum of laat het zo.</div>
    }

    @if (!Model.IsOwner)
    {
        <div class="melding" role="status">Je bekijkt deze prikker van @poll.OwnerName als beheerder. Sluiten en kiezen kan alleen de maker.</div>
    }

    <section class="kaart">
        <div class="kaart-kop">
            <h1>@poll.Title</h1>
            <span class="label @Weergave.StaatKlasse(poll, Model.IsOpen)">@Weergave.Staat(poll, Model.IsOpen)</span>
        </div>
        @if (Model.IsOpen && poll.HasDeadline)
        {
            <p class="zacht">@Weergave.SluitVanzelf(poll, passed: false)</p>
        }
        else if (Model.ClosedByDeadline)
        {
            <p class="zacht">@Weergave.SluitVanzelf(poll, passed: true)</p>
        }
        else if (!Model.IsOpen)
        {
            <p class="zacht">Gesloten op @Weergave.Moment(poll.ClosedOn).</p>
        }
        <div class="deel">
            <input class="deel-link" readonly value="@Model.ShareUrl" aria-label="Link naar de prikker" />
            <button type="button" class="knop" data-kopieer="@Model.ShareUrl">Kopieer link</button>
        </div>
        <p class="zacht" style="margin-top: 0.8rem">
            @total @(total == 1 ? "antwoord" : "antwoorden") ·
            <a href="/p/@poll.ShareToken">zelf antwoorden</a>
        </p>
    </section>

    @if (poll.HasPick)
    {
        <partial name="_Gekozen" model="Model.Pick" />
    }
    else if (Model.Results.Best.Count > 0)
    {
        <section class="kaart beste">
            <span class="lint">@(Model.Results.Best.Count == 1 ? "De winnaar" : "Gedeelde eerste plaats")</span>
            <div class="beste-lijst">
                @foreach (var tally in Model.Results.Best)
                {
                    <div class="beste-datum">
                        <span class="mini-kalender"><span>@Weergave.Maand(tally.Option.Date)</span><b>@Weergave.DagNummer(tally.Option.Date)</b></span>
                        <div>
                            <strong>@Weergave.Weekdag(tally.Option.Date), @Weergave.Tijd(tally.Option)</strong>
                            @Weergave.Telling(tally)
                        </div>
                    </div>
                }
            </div>
        </section>
    }

    @* The ranking shows even without answers, so the owner can pick a date agreed elsewhere (D22). *@
    <section class="kaart">
        <h2>Zo staat het ervoor</h2>
        <p class="zacht hint">
            Van beste naar minst gunstige datum: meeste ja, dan meeste misschien.
            @if (kiest && !poll.HasPick)
            {
                <span>Kies er een met <strong>Dit wordt het</strong>: dan @(Model.IsOpen ? "sluit de prikker en ziet" : "ziet") iedereen de datum.</span>
            }
        </p>
        <ol class="ranglijst">
            @for (var plek = 0; plek < Model.Results.Ranked.Count; plek++)
            {
                var tally = Model.Results.Ranked[plek];
                var isBest = best.Contains(tally.Option.Id);
                var isGekozen = poll.PickedOptionId == tally.Option.Id;
                <li class="rang-rij @(isBest ? "rang-beste" : string.Empty) @(isGekozen ? "rang-gekozen" : string.Empty)">
                    <span class="rang-nummer" aria-label="Plek @(plek + 1)">@(isBest ? "★" : (plek + 1).ToString(System.Globalization.CultureInfo.InvariantCulture))</span>
                    <div class="keuze-datum">
                        <span class="mini-kalender" aria-hidden="true"><span>@Weergave.Maand(tally.Option.Date)</span><b>@Weergave.DagNummer(tally.Option.Date)</b></span>
                        <div>
                            <strong>@Weergave.Weekdag(tally.Option.Date)</strong>
                            <span class="zacht">@Weergave.Tijd(tally.Option)</span>
                        </div>
                    </div>
                    <div class="rang-score">
                        <div class="rang-balk" aria-hidden="true">
                            <span class="balk-ja" style="width: @Weergave.Procent(tally.Yes, total)"></span>
                            <span class="balk-misschien" style="width: @Weergave.Procent(tally.Maybe, total)"></span>
                            <span class="balk-nee" style="width: @Weergave.Procent(tally.No, total)"></span>
                        </div>
                        <div class="rang-telling">@tally.Yes ja · @tally.Maybe misschien · @tally.No nee</div>
                    </div>
                    @if (isGekozen)
                    {
                        <div class="rang-kies"><span class="label label-gekozen">✓ gekozen</span></div>
                    }
                    else if (kiest)
                    {
                        <form method="post" asp-page-handler="Kies" class="rang-kies" data-bevestig="@Weergave.KiesVraag(tally.Option, Model.IsOpen)">
                            <input type="hidden" name="optie" value="@tally.Option.Id" />
                            <button type="submit" class="knop knop-licht">@(poll.HasPick ? "Kies deze" : "Dit wordt het")</button>
                        </form>
                    }
                </li>
            }
        </ol>
        <div class="legenda"><span><i class="l-ja"></i>ja</span><span><i class="l-misschien"></i>misschien</span><span><i class="l-nee"></i>nee</span></div>
    </section>

    @if (kiest && !Model.IsOpen && !poll.HasPick)
    {
        <p class="zacht">Toch opnieuw vragen? Maak een <a href="/Nieuw">nieuwe prikker</a>.</p>
    }

    <section class="kaart">
        <h2>Wie kan wanneer</h2>
        @if (total == 0)
        {
            <p>Nog niemand heeft geantwoord. Deel de link!</p>
        }
        else
        {
            <div class="tabel-scroll">
                <table class="uitslag">
                    <thead>
                        <tr>
                            <th scope="col">Wie</th>
                            @foreach (var option in poll.Options)
                            {
                                <th scope="col">@Weergave.Dag(option)<br /><small>@Weergave.Tijd(option)</small></th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var answer in Model.Results.Answers)
                        {
                            <tr>
                                <th scope="row">
                                    @answer.Name
                                    <small class="zacht">@answer.Email</small>
                                    @if (answer.Comment.Length > 0)
                                    {
                                        <span class="opmerking">“@answer.Comment”</span>
                                    }
                                </th>
                                @foreach (var option in poll.Options)
                                {
                                    var keuze = answer.ChoiceFor(option.Id);
                                    <td class="cel cel-@Weergave.Klasse(keuze)">@Weergave.Woord(keuze)</td>
                                }
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th scope="row">Ja / misschien / nee</th>
                            @foreach (var tally in Model.Results.Options)
                            {
                                <td>@tally.Yes / @tally.Maybe / @tally.No</td>
                            }
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </section>

    @if (Model.IsOpen && Model.IsOwner)
    {
        <form method="post" asp-page-handler="Sluiten" data-bevestig="Prikker sluiten? Daarna kan niemand meer antwoorden.">
            <button type="submit" class="knop knop-licht">Prikker sluiten</button>
        </form>
    }
}
