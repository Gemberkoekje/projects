# Copy to .env and fill in. .env is git-ignored and must never be committed.
#   cp .env.example .env

# PostgreSQL (local container). Use datumprikker-dev to match appsettings.Development.json.
POSTGRES_USER=datumprikker
POSTGRES_PASSWORD=
POSTGRES_DB=datumprikker
POSTGRES_PORT=5436

# The web app (only for `docker compose up webapp`)
WEBAPP_PORT=8086
ASPNETCORE_ENVIRONMENT=Production

# Optional sign-in providers; leave a pair empty to hide that provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Admin account ids, comma-separated (D16). Log in once and open Nieuwe prikker to see yours.
ADMIN_ACCOUNTS=
