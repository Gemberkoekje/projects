# Copy to .env and fill in. .env is git-ignored and must never be committed.
#   cp .env.example .env

# PostgreSQL (local container)
POSTGRES_USER=charactercreator
POSTGRES_PASSWORD=
POSTGRES_DB=charactercreator
POSTGRES_PORT=5435

# The web app
WEBAPP_PORT=8084
ASPNETCORE_ENVIRONMENT=Production

# Vortex ERU sign-in, optional. Leave the issuer empty to run anonymous only.
KEYCLOAK_ISSUER=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
