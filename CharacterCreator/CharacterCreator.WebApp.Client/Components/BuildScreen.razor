@inject RulesetClient Rulesets
@inject PlanStore Plans
@inject Browser Browser
@inject HttpClient Http
@inject NavigationManager Navigation

@* The build screen (DESIGN.md §5); its logic is in BuildScreen.razor.cs. *@
@if (!ready)
{
    @if (problem.Length > 0)
    {
        <div class="cc-banner cc-banner--error" role="alert">
            <b>@Ui.T("De regels konden niet geladen worden", "The rules could not be loaded")</b>
            @problem
        </div>
    }
    else
    {
        <p class="muted" data-render-state="browser">@Ui.T("De regels worden geladen…", "Loading the rules…")</p>
    }
}
else
{
    <div class="cc-build" data-render-state="browser">
        @if (MadeOnAnotherRuleset)
        {
            <div class="cc-banner cc-banner--service">
                <b>@Ui.T("Gemaakt op oudere regels", "Made on older rules")</b>
                @Ui.T(
                    $"Dit plan is gemaakt op {madeOn}; nu geldt {data.Ruleset.Id}. De opmerkingen tonen wat daardoor niet meer klopt.",
                    $"This plan was made on {madeOn}; {data.Ruleset.Id} applies now. The notes show what no longer fits.")
            </div>
        }

        @if (presetOffered)
        {
            <div class="cc-banner cc-banner--service">
                <b>@Ui.T($"Beginnen met {Ui.T(offeredPreset.Name)}?", $"Start from {Ui.T(offeredPreset.Name)}?")</b>
                @Ui.T("Dat vervangt het plan waar je nu aan werkt; met Ongedaan maken krijg je het terug.", "That replaces the plan you are working on; Undo brings it back.")
                <span class="cc-banner-actions">
                    <button type="button" class="va-btn va-btn--primary cc-btn-sm" @onclick="() => StartFromAsync(offeredPreset)">@Ui.T("Ja, begin ermee", "Yes, start from it")</button>
                    <button type="button" class="va-btn va-btn--ghost cc-btn-sm" @onclick="KeepMyPlan">@Ui.T("Houd mijn plan", "Keep my plan")</button>
                </span>
            </div>
        }

        @if (notice.Kind != NoticeKind.None)
        {
            <div class="cc-banner @NoticeClass()" role="status">
                @notice.Text
                @foreach (var item in notice.Items)
                {
                    <span class="cc-banner-item">@item</span>
                }
            </div>
        }

        @* An open menu closes on a click anywhere else: this layer catches it. *@
        @if (showPlans || showMore)
        {
            <div class="cc-menu-scrim" @onclick="CloseMenus"></div>
        }

        <section class="cc-card cc-build-head" aria-label="@Ui.T("Je plan", "Your plan")">
            <div class="cc-head-plan">
                <div class="cc-field cc-field--name">
                    <label for="cc-name">@Ui.T("Naam", "Name")</label>
                    <div class="cc-name-row">
                        <input id="cc-name" class="ctl" value="@name" placeholder="@Ui.T("Naam van je personage", "Your character's name")" @onchange="NameChangedAsync" />
                        @* A plan is a document (UX-REVIEW.md P7): switching between saved ones sits by its name. *@
                        <div class="cc-menu" @onkeydown="MenuKeyDown">
                            <button type="button" class="va-btn va-btn--ghost" aria-expanded="@(showPlans ? "true" : "false")" aria-controls="cc-plans" @onclick="TogglePlans">
                                @Ui.T($"Mijn plannen ({saved.Count})", $"My plans ({saved.Count})") <span aria-hidden="true">▾</span>
                            </button>
                            <div id="cc-plans" class="cc-menu-panel cc-menu-panel--plans" hidden="@(!showPlans)">
                                @if (saved.Count == 0)
                                {
                                    <p class="muted">@Ui.T("Nog niets opgeslagen in deze browser. Opslaan zet je plan hier.", "Nothing saved in this browser yet. Save puts your plan here.")</p>
                                }
                                else
                                {
                                    <ul class="cc-list">
                                        @foreach (var file in saved)
                                        {
                                            <li class="@(file.Id == planId ? "is-current" : string.Empty)">
                                                <span><strong>@Title(file)</strong> <span class="cc-sub">@When(file.SavedAt) · @Ui.T($"{file.Skills.Count} vaardigheden", $"{file.Skills.Count} skills")</span></span>
                                                <span class="cc-row-actions">
                                                    <button type="button" class="va-btn va-btn--secondary cc-btn-sm" @onclick="() => OpenSavedAsync(file)">@Ui.T("Openen", "Open")</button>
                                                    <button type="button" class="va-btn va-btn--ghost cc-btn-sm" aria-label="@Ui.T($"{Title(file)} verwijderen", $"Delete {Title(file)}")" @onclick="() => DeleteSavedAsync(file)">✕</button>
                                                </span>
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <fieldset class="cc-field cc-modes">
                    <legend>@Ui.T("Soort plan", "Kind of plan")</legend>
                    <label class="cc-radio">
                        <input type="radio" name="cc-mode" checked="@(plan.Mode == PlanMode.NewCharacter)" @onchange="() => ModeChangedAsync(PlanMode.NewCharacter)" />
                        @Ui.T($"Nieuw personage ({Ui.Number(data.Rules.Creation.StartXp)} XP)", $"New character ({Ui.Number(data.Rules.Creation.StartXp)} XP)")
                    </label>
                    <label class="cc-radio">
                        <input type="radio" name="cc-mode" checked="@(plan.Mode == PlanMode.Free)" @onchange="() => ModeChangedAsync(PlanMode.Free)" />
                        @Ui.T("Vrij plannen", "Free planning")
                    </label>
                </fieldset>

                @if (plan.Mode == PlanMode.Free)
                {
                    <div class="cc-field cc-field--xp">
                        <label for="cc-xp">XP</label>
                        <input id="cc-xp" class="ctl" type="number" min="0" step="0.25" value="@plan.Xp.ToString(System.Globalization.CultureInfo.InvariantCulture)" @onchange="XpChangedAsync" />
                    </div>
                    <div class="cc-field cc-field--events">
                        <label for="cc-events">@Ui.T("Na evenementen", "After events")</label>
                        <input id="cc-events" class="ctl" type="number" min="0" step="1" value="@events" @onchange="EventsChangedAsync" />
                        <span class="hint">@Ui.T($"Vult de XP in: {Ui.Number(data.Rules.Creation.StartXp)} plus wat elk evenement geeft.", $"Fills in the XP: {Ui.Number(data.Rules.Creation.StartXp)} plus each event's award.")</span>
                    </div>
                }
            </div>

            @* Where the XP bar (UX-REVIEW.md P1) will be: the counters, the rules' status, and the two
               main actions; the rest under "Meer" (P7). *@
            <div class="cc-build-bar">
                <dl class="cc-xp" aria-live="polite">
                    <div><dt>XP</dt><dd>@Ui.Number(evaluation.Xp)</dd></div>
                    <div><dt>@Ui.T("Uitgegeven", "Spent")</dt><dd>@Ui.Number(evaluation.Spent)</dd></div>
                    <div class="@(evaluation.Remaining < 0 ? "is-negative" : string.Empty)"><dt>@Ui.T("Over", "Left")</dt><dd>@Ui.Number(evaluation.Remaining)</dd></div>
                </dl>

                @if (data.Ruleset.Provisional)
                {
                    <details class="cc-badge">
                        <summary>@Ui.T("Voorlopige regels", "Provisional rules") <span aria-hidden="true">ⓘ</span></summary>
                        <p>
                            @Ui.T(
                                "Deze regels komen nog niet uit VOID, maar uit het concept van het regelboek. Kosten en vereisten kunnen nog veranderen.",
                                "These rules don't come from VOID yet, but from the rulebook draft. Costs and prerequisites may still change.")
                        </p>
                    </details>
                }

                <div class="cc-bar-actions">
                    <button type="button" class="va-btn va-btn--primary" @onclick="SaveAsync">@Ui.T("Opslaan", "Save")</button>
                    <button type="button" class="va-btn va-btn--secondary" disabled="@printing" @onclick="PrintAsync">
                        @(printing ? Ui.T("PDF wordt gemaakt…", "Making the PDF…") : Ui.T("Afdrukken", "Print"))
                    </button>
                    <div class="cc-menu" @onkeydown="MenuKeyDown">
                        <button type="button" class="va-btn va-btn--ghost" aria-expanded="@(showMore ? "true" : "false")" aria-controls="cc-more" @onclick="ToggleMore">
                            <span aria-hidden="true">⋯</span> @Ui.T("Meer", "More")
                        </button>
                        @* Hidden, never removed: the file input must outlive the menu closing, or the
                           chosen file never arrives. *@
                        <div id="cc-more" class="cc-menu-panel" hidden="@(!showMore)">
                            <button type="button" class="cc-menu-item" @onclick="ExportFromMenuAsync">@Ui.T("Exporteren als bestand", "Export as a file")</button>
                            <label class="cc-menu-item cc-file" @onclick="CloseMenus">
                                @Ui.T("Importeren…", "Import…")
                                <InputFile class="cc-visually-hidden" accept=".json,.dat" OnChange="ImportAsync" />
                            </label>
                            <button type="button" class="cc-menu-item" @onclick="NewFromMenuAsync">@Ui.T("Nieuw plan", "New plan")</button>
                        </div>
                    </div>
                </div>
            </div>

            @* Not on an empty plan: "15 XP left over" before anything is chosen says nothing new. *@
            @if (!plan.Planned.IsEmpty && General.Any())
            {
                <ul class="cc-general">
                    @foreach (var finding in General)
                    {
                        <li class="cc-note cc-note--@finding.Severity.ToString().ToLowerInvariant()">@words.Describe(finding)</li>
                    }
                </ul>
            }
        </section>

        @* An empty plan shows three ways to start instead of empty cards (UX-REVIEW.md P5). *@
        <div class="cc-build-grid @(plan.Planned.IsEmpty ? "is-empty" : string.Empty)">
            @if (plan.Planned.IsEmpty)
            {
                <div class="cc-area-start">
                    <section class="cc-card cc-start" aria-labelledby="cc-start-title">
                        <h2 id="cc-start-title">@Ui.T("Hoe wil je beginnen?", "How do you want to start?")</h2>
                        <div class="cc-start-way">
                            <h3>@Ui.T("Met een voorbeeld", "From a preset")</h3>
                            <div class="cc-start-presets">
                                @foreach (var starter in starters)
                                {
                                    <button type="button" class="cc-chip" @onclick="() => StartFromAsync(starter)">@Ui.T(starter.Name)</button>
                                }
                                <a class="cc-chip" href="voorbeelden">@Ui.T($"Alle {data.Content.Presets.Count}", $"All {data.Content.Presets.Count}") <span aria-hidden="true">›</span></a>
                            </div>
                        </div>
                        <div class="cc-start-way">
                            <h3>@Ui.T("Uit de oude builder", "From the old builder")</h3>
                            <p class="secondary">@Ui.T("Je .dat-bestand van builder.qequoia.nl, of een bestand dat je hier exporteerde.", "Your .dat file from builder.qequoia.nl, or a file you exported here.")</p>
                            <label class="va-btn va-btn--secondary cc-file">
                                @Ui.T("Bestand inlezen", "Read a file")
                                <InputFile class="cc-visually-hidden" accept=".json,.dat" OnChange="ImportAsync" />
                            </label>
                        </div>
                        <div class="cc-start-way">
                            <h3>@Ui.T("Zelf kiezen", "Choose yourself")</h3>
                            <p class="secondary">@Ui.T("Kies je eerste vaardigheid in de lijst; elke vaardigheid zegt of ze kan.", "Pick your first skill from the list; each skill says whether it fits.")</p>
                            <button type="button" class="va-btn va-btn--ghost" @onclick="ToTheListAsync">@Ui.T("Naar de lijst", "To the list")</button>
                        </div>
                    </section>
                </div>
            }
            else
            {
                <div class="cc-area-chosen">
                    <ChosenSkills Ui="Ui" Words="words" Data="data" Plan="plan" Evaluation="evaluation" OnMore="MoreAsync" OnLess="LessAsync" OnRemove="RemoveAllAsync" />
                </div>
            }

            <div class="cc-area-picker">
                <SkillPicker Ui="Ui" Words="words" Data="data" Plan="plan" Options="options" Remaining="evaluation.Remaining" OnAdd="AddAsync" OnLess="LessAsync" />
            </div>

            @if (!plan.Planned.IsEmpty)
            {
                <div class="cc-area-summary">
                    <SummaryPanels Ui="Ui" Words="words" Data="data" Plan="plan" Evaluation="evaluation" />
                </div>
            }
        </div>

        @* Feedback where the eye is after a click (UX-REVIEW.md P4): a toast with Undo, and the one
           question left (removing what other skills need), at the bottom of the screen. The live
           region is always there, so screen readers hear the toast appear. *@
        <div class="cc-dock">
            @if (pending.IsWaiting)
            {
                <div class="cc-toast cc-toast--question" role="alertdialog" aria-labelledby="cc-question">
                    <p id="cc-question">
                        <b>@Ui.T($"{words.Name(pending.Skill)} is nodig voor", $"{words.Name(pending.Skill)} is needed for") @Names(pending.Dependants).</b>
                        @Ui.T("Die ook verwijderen?", "Remove those too?")
                    </p>
                    <span class="cc-toast-actions">
                        <button type="button" class="va-btn va-btn--danger cc-btn-sm" @onclick="() => ConfirmRemovalAsync(true)">@Ui.T("Die ook verwijderen", "Remove those too")</button>
                        <button type="button" class="va-btn va-btn--secondary cc-btn-sm" @onclick="() => ConfirmRemovalAsync(false)">@Ui.T("Alleen deze", "Only this one")</button>
                        <button type="button" class="va-btn va-btn--ghost cc-btn-sm" @onclick="CancelRemoval">@Ui.T("Annuleren", "Cancel")</button>
                    </span>
                </div>
            }
            <div class="cc-dock-live" aria-live="polite">
                @if (toast.Kind != NoticeKind.None && !pending.IsWaiting)
                {
                    <div class="cc-toast cc-toast--@toast.Kind.ToString().ToLowerInvariant()" @onmouseenter="() => HoldToast(true)" @onmouseleave="() => HoldToast(false)" @onfocusin="() => HoldToast(true)" @onfocusout="() => HoldToast(false)">
                        <span class="cc-toast-text">@toast.Text</span>
                        @if (toast.CanUndo)
                        {
                            <button type="button" class="cc-toast-undo" @onclick="UndoAsync">@Ui.T("Ongedaan maken", "Undo")</button>
                        }
                        <button type="button" class="cc-toast-close" aria-label="@Ui.T("Sluiten", "Close")" @onclick="CloseToast">✕</button>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    /// <summary>The language.</summary>
    [Parameter, EditorRequired]
    public Ui Ui { get; set; }

    /// <summary>A preset to start from (<c>?voorbeeld=</c>); empty for none.</summary>
    [Parameter]
    public string Preset { get; set; } = string.Empty;

    private string NoticeClass() => notice.Kind switch
    {
        NoticeKind.Error => "cc-banner--error",
        NoticeKind.Warning => "cc-banner--service",
        _ => "cc-banner--success",
    };
}
