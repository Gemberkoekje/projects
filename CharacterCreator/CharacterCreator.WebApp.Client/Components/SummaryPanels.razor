@* The summary (DESIGN.md §5), compact for the "Jouw personage" column and the phone's Overzicht tab
   (UX-REVIEW.md P2): energy per day and the properties on a line each, the spells, techniques and
   recipes folded with their counts, as tiles with a details panel. *@
@{
    var energy = Evaluation.Energy.Where(total => total.Kind == EnergyKind.Energy).ToList();
    var spells = PlanSummary.Spells(Data.Content, Plan);
    var recipes = PlanSummary.Recipes(Data.Content, Plan);
}
<section class="cc-card cc-summary" aria-labelledby="cc-summary-title">
    <h2 id="cc-summary-title">@Ui.T("Overzicht", "Summary")</h2>

    <dl class="cc-sumlines">
        <div>
            <dt>@Ui.T("Energie per dag", "Energy per day")</dt>
            <dd>
                @if (energy.Count == 0)
                {
                    <span class="muted">@Ui.T("Geen", "None")</span>
                }
                @foreach (var total in energy)
                {
                    <span class="echip @PlanSummary.EnergyClass(total.Type)"><span class="dot" aria-hidden="true"></span>@Words.EnergyType(total.Type) <strong>@total.Amount</strong></span>
                }
            </dd>
        </div>
        <div>
            <dt>@Ui.T("Eigenschappen", "Properties")</dt>
            <dd>
                @foreach (var property in PlanSummary.Properties(Ui, Words, Data.Content, Plan, Evaluation))
                {
                    <span class="cc-prop">@property.Label <strong>@property.Value</strong></span>
                }
            </dd>
        </div>
    </dl>

    <details class="cc-fold">
        <summary>@Ui.T("Spreuken en technieken", "Spells and techniques") <span class="cc-count">@spells.Count</span></summary>
        @if (spells.Count == 0)
        {
            <p class="muted">@Ui.T("Geen.", "None.")</p>
        }
        else
        {
            <div class="cc-tiles">
                @foreach (var spell in spells)
                {
                    <button type="button" class="cc-tile @(selectedSpell == spell.Id ? "is-on" : string.Empty)" aria-pressed="@(selectedSpell == spell.Id ? "true" : "false")" @onclick="() => selectedSpell = selectedSpell == spell.Id ? 0 : spell.Id">@Ui.T(spell.Name)</button>
                }
            </div>
            var shown = spells.FirstOrDefault(spell => spell.Id == selectedSpell);
            if (shown is not null)
            {
                <div class="cc-tile-details">
                    <h3>@Ui.T(shown.Name)</h3>
                    <dl class="cc-facts">
                        @Fact(Ui.T("Energie", "Energy"), $"{Ui.T(shown.EnergyType)} {shown.Cost}".Trim())
                        @Fact(Ui.T("Incantatie", "Incantation"), Ui.T(shown.Incantation))
                        @Fact(Ui.T("Effect", "Effect"), Ui.T(shown.Effect))
                        @Fact(Ui.T("Duur", "Duration"), Ui.T(shown.Duration))
                        @Fact(Ui.T("Regelboek", "Rulebook"), shown.Page > 0 ? $"{Ui.T("Spreuken en Technieken, blz.", "Spells and Techniques, p.")} {shown.Page}" : string.Empty)
                    </dl>
                    @if (!string.IsNullOrWhiteSpace(Ui.T(shown.Description)))
                    {
                        <p class="cc-description">@Ui.T(shown.Description)</p>
                    }
                </div>
            }
        }
    </details>

    <details class="cc-fold">
        <summary>@Ui.T("Recepten", "Recipes") <span class="cc-count">@recipes.Count</span></summary>
        @if (recipes.Count == 0)
        {
            <p class="muted">@Ui.T("Geen.", "None.")</p>
        }
        else
        {
            <div class="cc-tiles">
                @foreach (var recipe in recipes)
                {
                    <button type="button" class="cc-tile @(selectedRecipe == recipe.Id ? "is-on" : string.Empty)" aria-pressed="@(selectedRecipe == recipe.Id ? "true" : "false")" @onclick="() => selectedRecipe = selectedRecipe == recipe.Id ? 0 : recipe.Id">@Ui.T(recipe.Name)</button>
                }
            </div>
            var shown = recipes.FirstOrDefault(recipe => recipe.Id == selectedRecipe);
            if (shown is not null)
            {
                <div class="cc-tile-details">
                    <h3>@Ui.T(shown.Name)</h3>
                    <dl class="cc-facts">
                        @Fact(Ui.T("Effect", "Effect"), Ui.T(shown.Effect))
                        @Fact(Ui.T("Inspiratie", "Inspiration"), shown.Inspiration)
                        @Fact(Ui.T("Componenten", "Components"), Ui.T(shown.Components))
                    </dl>
                </div>
            }
        }
    </details>
</section>

@code {
    private int selectedSpell;
    private int selectedRecipe;

    /// <summary>The language.</summary>
    [Parameter, EditorRequired]
    public Ui Ui { get; set; }

    /// <summary>The words for energy types.</summary>
    [Parameter, EditorRequired]
    public FindingWords Words { get; set; }

    /// <summary>The ruleset.</summary>
    [Parameter, EditorRequired]
    public LoadedRuleset Data { get; set; }

    /// <summary>The plan.</summary>
    [Parameter, EditorRequired]
    public Plan Plan { get; set; }

    /// <summary>What the engine makes of it.</summary>
    [Parameter, EditorRequired]
    public PlanEvaluation Evaluation { get; set; }

    private static RenderFragment Fact(string label, string value) => builder =>
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return;
        }

        builder.OpenElement(0, "div");
        builder.OpenElement(1, "dt");
        builder.AddContent(2, label);
        builder.CloseElement();
        builder.OpenElement(3, "dd");
        builder.AddContent(4, value);
        builder.CloseElement();
        builder.CloseElement();
    };
}
