@* The summary (DESIGN.md §5), compact for the "Jouw personage" column and the phone's Overzicht tab
   (UX-REVIEW.md P2): energy per day and the properties on a line each, the spells, techniques and
   recipes folded with their counts. Inside, the tiles are grouped under the skill that brings them,
   with their cost, and a tile's details open right after it; on a phone as a sheet from the bottom
   (P10). *@
@{
    var energy = Evaluation.Energy.Where(total => total.Kind == EnergyKind.Energy).ToList();
    var spellGroups = PlanSummary.SpellGroups(Data.Content, Plan);
    var recipeGroups = PlanSummary.RecipeGroups(Data.Content, Plan);
    var spellCount = spellGroups.Sum(group => group.Items.Count);
    var recipeCount = recipeGroups.Sum(group => group.Items.Count);
}
<section class="cc-card cc-summary" aria-labelledby="cc-summary-title">
    <h2 id="cc-summary-title">@Ui.T("Overzicht", "Summary")</h2>

    <dl class="cc-sumlines">
        <div>
            <dt>@Ui.T("Energie per dag", "Energy per day")</dt>
            <dd>
                @if (energy.Count == 0)
                {
                    <span class="muted">@Ui.T("Geen", "None")</span>
                }
                @foreach (var total in energy)
                {
                    <span class="echip @PlanSummary.EnergyClass(total.Type)"><span class="dot" aria-hidden="true"></span>@Words.EnergyType(total.Type) <strong>@total.Amount</strong></span>
                }
            </dd>
        </div>
        <div>
            <dt>@Ui.T("Eigenschappen", "Properties")</dt>
            <dd>
                @foreach (var property in PlanSummary.Properties(Ui, Words, Data.Content, Plan, Evaluation))
                {
                    <span class="cc-prop">@property.Label <strong>@property.Value</strong></span>
                }
            </dd>
        </div>
    </dl>

    <details class="cc-fold">
        <summary>@Ui.T("Spreuken en technieken", "Spells and techniques") <span class="cc-count">@spellCount</span></summary>
        @if (spellCount == 0)
        {
            <p class="muted">@Ui.T("Geen.", "None.")</p>
        }
        @foreach (var group in spellGroups)
        {
            <details class="cc-tilegroup" open="@(group.Items.Count <= FoldAbove)">
                <summary>@Ui.T(group.Title) <span class="cc-count">@group.Items.Count</span></summary>
                <div class="cc-tiles">
                    @foreach (var spell in group.Items)
                    {
                        var on = selected == Selection.Spell(spell.Id);
                        <button type="button" class="cc-tile @(on ? "is-on" : string.Empty)" aria-expanded="@(on ? "true" : "false")" aria-controls="cc-tile-details" @onclick="() => Toggle(Selection.Spell(spell.Id))">
                            @Ui.T(spell.Name)
                            @if (HasCost(spell.Cost))
                            {
                                <span class="cc-tile-cost" title="@($"{Ui.T(spell.EnergyType)} {spell.Cost}".Trim())"><span class="dot @PlanSummary.EnergyClass(spell.EnergyType.En)" aria-hidden="true"></span>@spell.Cost</span>
                            }
                        </button>
                        @if (on)
                        {
                            <div id="cc-tile-details" class="cc-tile-details" role="region" aria-label="@Ui.T(spell.Name)" @onkeydown="CloseOnEscape">
                                <div class="cc-tile-details-head">
                                    <h3>@Ui.T(spell.Name)</h3>
                                    <button type="button" class="cc-tile-close" aria-label="@Ui.T("Sluiten", "Close")" @onclick="() => selected = Selection.None">✕</button>
                                </div>
                                <dl class="cc-facts">
                                    @Fact(Ui.T("Energie", "Energy"), $"{Ui.T(spell.EnergyType)} {spell.Cost}".Trim())
                                    @Fact(Ui.T("Incantatie", "Incantation"), Ui.T(spell.Incantation))
                                    @Fact(Ui.T("Effect", "Effect"), Ui.T(spell.Effect))
                                    @Fact(Ui.T("Duur", "Duration"), Ui.T(spell.Duration))
                                    @Fact(Ui.T("Regelboek", "Rulebook"), spell.Page > 0 ? $"{Ui.T("Spreuken en Technieken, blz.", "Spells and Techniques, p.")} {spell.Page}" : string.Empty)
                                </dl>
                                @if (!string.IsNullOrWhiteSpace(Ui.T(spell.Description)))
                                {
                                    <p class="cc-description">@Ui.T(spell.Description)</p>
                                }
                            </div>
                        }
                    }
                </div>
            </details>
        }
    </details>

    <details class="cc-fold">
        <summary>@Ui.T("Recepten", "Recipes") <span class="cc-count">@recipeCount</span></summary>
        @if (recipeCount == 0)
        {
            <p class="muted">@Ui.T("Geen.", "None.")</p>
        }
        @foreach (var group in recipeGroups)
        {
            <details class="cc-tilegroup" open="@(group.Items.Count <= FoldAbove)">
                <summary>@Ui.T(group.Title) <span class="cc-count">@group.Items.Count</span></summary>
                <div class="cc-tiles">
                    @foreach (var recipe in group.Items)
                    {
                        var on = selected == Selection.Recipe(recipe.Id);
                        <button type="button" class="cc-tile @(on ? "is-on" : string.Empty)" aria-expanded="@(on ? "true" : "false")" aria-controls="cc-tile-details" @onclick="() => Toggle(Selection.Recipe(recipe.Id))">
                            @Ui.T(recipe.Name)
                            @if (HasCost(recipe.Inspiration))
                            {
                                <span class="cc-tile-cost" title="@Ui.T($"Inspiratie {recipe.Inspiration}", $"Inspiration {recipe.Inspiration}")"><span class="dot cc-en-inspiration" aria-hidden="true"></span>@recipe.Inspiration</span>
                            }
                        </button>
                        @if (on)
                        {
                            <div id="cc-tile-details" class="cc-tile-details" role="region" aria-label="@Ui.T(recipe.Name)" @onkeydown="CloseOnEscape">
                                <div class="cc-tile-details-head">
                                    <h3>@Ui.T(recipe.Name)</h3>
                                    <button type="button" class="cc-tile-close" aria-label="@Ui.T("Sluiten", "Close")" @onclick="() => selected = Selection.None">✕</button>
                                </div>
                                <dl class="cc-facts">
                                    @Fact(Ui.T("Effect", "Effect"), Ui.T(recipe.Effect))
                                    @Fact(Ui.T("Inspiratie", "Inspiration"), recipe.Inspiration)
                                    @Fact(Ui.T("Componenten", "Components"), Ui.T(recipe.Components))
                                </dl>
                            </div>
                        }
                    }
                </div>
            </details>
        }
    </details>
</section>

@code {
    /// <summary>A group with more tiles than this starts folded (UX-REVIEW.md P10).</summary>
    private const int FoldAbove = 12;

    private Selection selected = Selection.None;

    /// <summary>The language.</summary>
    [Parameter, EditorRequired]
    public Ui Ui { get; set; }

    /// <summary>The words for energy types.</summary>
    [Parameter, EditorRequired]
    public FindingWords Words { get; set; }

    /// <summary>The ruleset.</summary>
    [Parameter, EditorRequired]
    public LoadedRuleset Data { get; set; }

    /// <summary>The plan.</summary>
    [Parameter, EditorRequired]
    public Plan Plan { get; set; }

    /// <summary>What the engine makes of it.</summary>
    [Parameter, EditorRequired]
    public PlanEvaluation Evaluation { get; set; }

    private static bool HasCost(string cost) => !string.IsNullOrWhiteSpace(cost) && cost.Trim() != "0";

    /// <summary>One tile open at a time, spell or recipe; the same tile again closes it.</summary>
    private void Toggle(Selection tile) => selected = selected == tile ? Selection.None : tile;

    private void CloseOnEscape(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            selected = Selection.None;
        }
    }

    /// <summary>The open tile: a spell or a recipe by its id.</summary>
    private readonly record struct Selection(bool IsRecipe, int Id)
    {
        public static Selection None => default;

        public static Selection Spell(int id) => new (false, id);

        public static Selection Recipe(int id) => new (true, id);
    }

    private static RenderFragment Fact(string label, string value) => builder =>
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return;
        }

        builder.OpenElement(0, "div");
        builder.OpenElement(1, "dt");
        builder.AddContent(2, label);
        builder.CloseElement();
        builder.OpenElement(3, "dd");
        builder.AddContent(4, value);
        builder.CloseElement();
        builder.CloseElement();
    };
}
