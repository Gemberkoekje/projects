@* The light/dark toggle. vortex-theme.js does the work: it cycles system → light → dark, writes the
   shared vortex-theme cookie and sets the label from the data-label-* attributes. *@
<button type="button" class="vtx-theme-toggle" data-vortex-theme-toggle
        data-label-system="Thema volgt het systeem. Klik voor licht."
        data-label-light="Licht thema. Klik voor donker."
        data-label-dark="Donker thema. Klik om het systeem te volgen.">
    <span class="vtx-theme-icon" aria-hidden="true"></span>
</button>
