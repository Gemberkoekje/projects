@* The light/dark toggle. vortex-theme.js does the work: it cycles system → light → dark, writes the
   shared vortex-theme cookie and sets the label from the data-label-* attributes. *@
<button type="button" class="vtx-theme-toggle" data-vortex-theme-toggle
        data-label-system="@Ui.T("Thema volgt het systeem. Klik voor licht.", "Theme follows the system. Click for light.")"
        data-label-light="@Ui.T("Licht thema. Klik voor donker.", "Light theme. Click for dark.")"
        data-label-dark="@Ui.T("Donker thema. Klik om het systeem te volgen.", "Dark theme. Click to follow the system.")">
    <span class="vtx-theme-icon" aria-hidden="true"></span>
</button>

@code {
    /// <summary>The language.</summary>
    [Parameter]
    public Ui Ui { get; set; } = Ui.Dutch;
}
