<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DatBlueprint</AssemblyName>
    <RootNamespace>DatBlueprint</RootNamespace>
    <!-- Deliberately self-contained: no project references, no NuGet packages. It reads only the
         .dat you point it at and writes an SVG + JSON. It never bundles or ships game data. -->
  </PropertyGroup>

</Project>
