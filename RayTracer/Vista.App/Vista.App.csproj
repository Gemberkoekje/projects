<Project Sdk="Microsoft.NET.Sdk">

  <!-- Vista.App (vista-plan §8.3): the Vista host on the reusable RayTracer.Gpu DXR backend — the same seam
       RayTracer.Maze and Pinball.App sit on. M0 ships the headless preview CLI front end and offline
       integrator v0 (Shaders/VistaIntegrator.hlsl) with its own D3D12 host (Gpu/D3D12VistaRenderer.cs); from
       RayTracer.Gpu it uses only ShaderCompiler (vista-plan §8.1). Settings mirror Pinball.App so the shared
       backend compiles unchanged. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>Vista.App</RootNamespace>
    <AssemblyName>Vista.App</AssemblyName>
  </PropertyGroup>

  <!-- The shaders load from AppContext.BaseDirectory/Shaders/ (Gpu/ShaderSource.cs inlines the .hlsli), so they ship
       next to the .exe: the integrator, the atmosphere LUT builders, their shared atmosphere include and the
       integrator's sky-light and materials includes. -->
  <ItemGroup>
    <None Update="Shaders\VistaIntegrator.hlsl;Shaders\VistaAtmosphereLuts.hlsl;Shaders\VistaErosion.hlsl;Shaders\VistaAtmosphere.hlsli;Shaders\VistaSkyLight.hlsli;Shaders\VistaMaterials.hlsli">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Intel Open Image Denoise (vista-plan §10 M1.6): tools/fetch-oidn.ps1 fetches the pinned release into the git-ignored
       ../.deps/oidn, and the build copies the DLLs the CPU and CUDA devices need next to the .exe. When it has not been fetched
       (CI, a fresh clone) nothing is copied and a render with denoising warns and writes the raw image only. -->
  <PropertyGroup>
    <OidnBin>$(MSBuildThisFileDirectory)../.deps/oidn/bin/</OidnBin>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(OidnBin)OpenImageDenoise.dll')">
    <None Include="$(OidnBin)OpenImageDenoise.dll;$(OidnBin)OpenImageDenoise_core.dll;$(OidnBin)OpenImageDenoise_device_cpu.dll;$(OidnBin)OpenImageDenoise_device_cuda.dll;$(OidnBin)tbb*.dll"
          Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../RayTracer.Core/RayTracer.csproj" />
    <ProjectReference Include="../RayTracer.Gpu/RayTracer.Gpu.csproj" />
    <ProjectReference Include="../Vista.Core/Vista.Core.csproj" />
  </ItemGroup>

</Project>
