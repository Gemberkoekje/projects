<Project Sdk="Microsoft.NET.Sdk">

  <!-- Vista.App (vista-plan §8.3): the Vista host on the reusable RayTracer.Gpu DXR backend — the same seam
       RayTracer.Maze and Pinball.App sit on. M0 ships the headless preview CLI front end (argument parsing,
       world generation, mesh build, batch plan, sidecar); the offline integrator, its D3D12 host and the
       GPU readback still need the RTX 3070 (vista-plan §10, M0 "needs the 3070"). Settings mirror
       Pinball.App so the shared backend compiles unchanged. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>Vista.App</RootNamespace>
    <AssemblyName>Vista.App</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../RayTracer.Core/RayTracer.csproj" />
    <ProjectReference Include="../RayTracer.Gpu/RayTracer.Gpu.csproj" />
    <ProjectReference Include="../Vista.Core/Vista.Core.csproj" />
  </ItemGroup>

</Project>
