{"nodes": [{"id": "pinball_plan_vision", "label": "Space Cadet RT Vision (spectral ray-traced pinball)", "file_type": "concept", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fixed camera means the static playfield can be rendered by the full Phase 6 spectral path and converge over many frames to near-offline look at real-time cost; pinball is the mirror image of the maze (static scene, moving camera vs static camera, few moving parts)."}, {"id": "pinball_plan_design_pillars", "label": "Pinball Design Pillars & Non-goals", "file_type": "rationale", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Faithful to the Windows table (no multiball, Replay free balls); reuse the engine don't fork; static playfield = full RT, movers = cheap tier; spectral-native color; gate on cost via Classic/RT-Showcase presets; determinism; physics fidelity is a first-class pillar where realism wins over 1995 feel."}, {"id": "pinball_plan_space_cadet_game_design", "label": "Space Cadet Game Design (faithful, code-verified)", "file_type": "concept", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pinball_plan_rank_ladder", "label": "Nine-Rank Starfleet Career Ladder", "file_type": "concept", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pinball_plan_missions", "label": "Mission System (select -> accept -> complete, 17 missions)", "file_type": "concept", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pinball_plan_replay_save", "label": "Replay Free-Ball Save (marquee mechanic)", "file_type": "concept", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pinball_plan_spacecadetpinball_ref", "label": "k4zmu2a/SpaceCadetPinball (control.cpp)", "file_type": "document", "source_file": "pinball-plan.md", "source_location": null, "source_url": "https://github.com/k4zmu2a/SpaceCadetPinball", "captured_at": null, "author": null, "contributor": null}, {"id": "pinball_plan_hybrid_rendering", "label": "Hybrid Rendering Within One DXR Dispatch", "file_type": "concept", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pinball_plan_one_dispatch_fact", "label": "Phase 6 is One Dispatch, Not a G-buffer Compositor", "file_type": "rationale", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Phase6Renderer.RenderFrame records exactly one inline DXR 1.1 trace as a compute shader against one Scene TLAS; there is no rasterizer/G-buffer, so 'static vs moving' is a per-primitive shading budget inside ShadeSample, not a separate pass. Occlusion, ball reflection and contact shadow fall out of the single TLAS."}, {"id": "pinball_plan_static_tier", "label": "Static Playfield Tier (full spectral, converged)", "file_type": "concept", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fixed/slow camera lets AccumulationBuffer + TaaResolver converge these pixels to high effective spp; an insert/light change must NOT route through _forceReset (throws away indirect convergence) but use an in-place short-window reconverge."}, {"id": "pinball_plan_dynamic_tier", "label": "Dynamic Tier (cheap single-bounce hero/RGB movers)", "file_type": "concept", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Movers are deliberately NOT spectral path traced: fast movers break temporal reuse (a ball crosses a pixel in 2-3 frames), so they ride a bounded MotionSampleCap window with single-bounce direct shading, generalizing the shipped isMover path."}, {"id": "pinball_plan_dynamic_classification", "label": "Dynamic Bit + Cheap Mover Shading Branch", "file_type": "concept", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pinball_plan_tlas_movers", "label": "Movers in the TLAS (sphere refit + rigid instance transform)", "file_type": "concept", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pinball_plan_temporal_machinery", "label": "Temporal Machinery: Keep for Static, Bypass for Movers", "file_type": "concept", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pinball_plan_ghost_trail_fix", "label": "Hit-id Restart (the ghost-trail fix)", "file_type": "concept", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The per-pixel restart uses a 1-bit hit/miss mask, so a fast ball sliding off a pixel lets the ramp behind blend into the ball's stale mean; storing a dynamic-vs-static id and restarting on id change forces a clean 1-sample restart."}, {"id": "pinball_plan_path_touched_dynamic", "label": "pathTouchedDynamic Flag (ball ghost in static specular)", "file_type": "concept", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pinball_plan_chrome_ball_shots", "label": "Chrome Ball Money Shots (mirror + contact shadow)", "file_type": "concept", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both already shipped: mirror reflection via TraceSpecularRadiance into the static TLAS (cap to 1 bounce, hero-only ideal for neutral chrome); hard contact shadow free because an opaque sphere commits as an occluder in TraceTransmittance's candidate loop."}, {"id": "pinball_plan_emissive_shading", "label": "Emissive-Surface Shading (new, largest renderer add)", "file_type": "concept", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SurfaceKind.Emissive exists only as an enum with no tracer term (emissive AOV is literally zero); neon inserts/wormholes/bumper-pops need an emission term in ShadeSample's diffuse terminal, the indirect bounce and as an NEE emitter. Prerequisite for P0 to look right."}, {"id": "pinball_plan_performance_budget", "label": "RTX 3070 Performance Budget & Presets", "file_type": "concept", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The real cost is the per-frame AS refit stalls (fold into the trace command list, keep the TLAS UAV barrier, drop the redundant WaitForGpu), not ray throughput; caustics/photon map stay off the frame budget (built once at table load)."}, {"id": "pinball_plan_classic_preset", "label": "Classic Preset (60 fps)", "file_type": "concept", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pinball_plan_rt_showcase_preset", "label": "RT Showcase Preset (30-60 fps)", "file_type": "concept", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pinball_plan_physics_model", "label": "Realistic 3-D Rigid-Body Physics (second fidelity pillar)", "file_type": "concept", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pinball_plan_trajectory_from_physics", "label": "Trajectory Comes From Physics (governing principle)", "file_type": "rationale", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The exact analogue of 'color comes from spectral physics, never a hard-coded tint': trajectory comes from gravity/inertia/friction/restitution/spin/drag in measured SI units, never a feel-tweak; validated by fixed-seed unit tests against closed-form results, realism wins over 1995 feel."}, {"id": "pinball_plan_rigid_body_6dof", "label": "6-DOF Ball Rigid-Body Model (double precision)", "file_type": "concept", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Full 3-D gravity applied to the body against a tilted playfield collider (not pre-projected slope accel), so the ball naturally climbs ramps, goes airborne and lands with no special-casing; solid-sphere isotropic inertia makes I-inverse just 1/I."}, {"id": "pinball_plan_collision_primitives", "label": "Analytic Collider Zoo (Plane/Sphere/Cylinder/Capsule/Quad/Arc/Mesh)", "file_type": "concept", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every sphere-vs-X closest-feature query is closed-form; broadphase reuses the existing float BVH conservatively while narrowphase/integration run in double."}, {"id": "pinball_plan_contact_solver", "label": "Restitution + Coulomb-Friction Impulse Solver", "file_type": "concept", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Normal impulse is torque-free (passes through sphere centre) so bounces never create spin; all spin comes from the tangential friction impulse capped by the Coulomb cone with tangential reduced mass 2m/7; grip vs slide emerges from j_t* vs mu*j_n."}, {"id": "pinball_plan_spin", "label": "Spin, Magnus & Rebound-Angle Coupling", "file_type": "concept", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Spin is generated only through the tangential friction impulse; it changes outgoing angle via tangential coupling (backspin/topspin/sidespin alter rebound). Magnus is implemented physically correctly but is honestly tiny (a few mm) for a dense steel ball."}, {"id": "pinball_plan_aero_drag", "label": "Aerodynamic Drag & Rolling Resistance", "file_type": "concept", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Quadratic drag is negligible at pinball speed (terminal velocity ~70 m/s) but included for correctness; rolling resistance is the dominant non-Coulomb loss that shapes pacing (how far a slow ball coasts)."}, {"id": "pinball_plan_integration_ccd", "label": "Fixed-Timestep Symplectic Euler + CCD (1000 Hz)", "file_type": "concept", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Symplectic Euler over RK4 because it doesn't pump energy into resting contact; CCD is mandatory because a 5-10 m/s ball moves 5-10 mm/step and would tunnel thin walls; swept-sphere conservative advancement reuses the BVH broadphase; determinism via fixed h, fixed contact order, double, seeded PRNG."}, {"id": "pinball_plan_actuators", "label": "Actuators (flippers, plunger, bumpers, nudge/tilt)", "file_type": "concept", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Flippers are kinematic torque-limited capsules whose surface velocity u=omega x r transfers push+spin (the skill mechanic emerges, unscripted); bumpers/slingshots are the one place energy is added via a measured coil impulse; nudge impulses the ball and shifts the table frame with a tilt-bob leaky integrator."}, {"id": "pinball_plan_build_vs_buy", "label": "Build vs Buy: Custom Analytic Solver", "file_type": "rationale", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One dynamic ball + static world + few kinematic actuators makes an exact analytic single-sphere solver viable; custom wins on physical control, closed-form-testable determinism and fit; BepuPhysics v2 is the pure-C# fallback if scope grows to multi-ball; keep PhysicsWorld swappable behind an interface."}, {"id": "pinball_plan_physics_validation", "label": "Deterministic Physics Validation (8 closed-form tests)", "file_type": "concept", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pinball_plan_fixed_timestep", "label": "Fixed Timestep Decoupled From Converge Rate", "file_type": "concept", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pinball_plan_game_state_scoring", "label": "Game State & Scoring (ranks/missions/replay/tilt)", "file_type": "concept", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pinball_plan_engine_maze_separation", "label": "Engine <-> Maze Separation (Milestone E)", "file_type": "concept", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Break three RayTracer.Core maze leaks (CameraController->MazeNavigator dependency, MazeGeometryBuilder.CellSize world-scale constant, LensOptions doc comment) and split RayTracer.Gpu into a reusable backend + a new RayTracer.Maze app; acceptance is a pure move-and-reparameterize with goldens unmoved."}, {"id": "pinball_plan_six_assemblies", "label": "Six-Assembly Target Layout", "file_type": "concept", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pinball_plan_milestone_e", "label": "Milestone E - Extract Engine from Maze (DONE)", "file_type": "concept", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pinball_plan_p0", "label": "P0 - Static Table Render (no gameplay)", "file_type": "concept", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pinball_plan_p1", "label": "P1 - Dynamic Classification + Cheap Mover Branch", "file_type": "concept", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pinball_plan_p2", "label": "P2 - Hit-id Restart (ghost-trail fix)", "file_type": "concept", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pinball_plan_p3", "label": "P3 - Mover TAA Stencil", "file_type": "concept", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pinball_plan_p4", "label": "P4 - Rigid Mover Poses + AS Refit Without Stalls (DONE)", "file_type": "concept", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pinball_plan_p5", "label": "P5 - Physics Core Pinball.Core (DONE)", "file_type": "concept", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pinball_plan_p6", "label": "P6 - Game Host, Input, Loop Pinball.App (DONE)", "file_type": "concept", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pinball_plan_p7", "label": "P7 - Game State, Missions, Scoring, Replay, Tilt", "file_type": "concept", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pinball_plan_p8", "label": "P8 - RT Showcase Preset + Spectral Polish + Bloom", "file_type": "concept", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pinball_plan_p9", "label": "P9 - Audio + Attract Mode + Finish", "file_type": "concept", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "raytracer_gpu_phase6renderer_phase6renderer", "label": "Phase6Renderer", "file_type": "code", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "raytracer_gpu_shaders_pathtracephase6_csmain", "label": "PathTracePhase6.hlsl (CSMain / ShadeSample)", "file_type": "code", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "raytracer_core_gpu_phase2reference_phase2reference", "label": "Phase2Reference", "file_type": "code", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pinball_core_content_pinballtablescene_pinballtablescene", "label": "PinballTableScene", "file_type": "code", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pinball_core_table_pinballtable_pinballtable", "label": "PinballTable", "file_type": "code", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pinball_core_game_pinballgame_pinballgame", "label": "PinballGame", "file_type": "code", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pinball_core_game_pinballinput_pinballinput", "label": "PinballInput", "file_type": "code", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pinball_core_game_gamestate_gamestate", "label": "GameState", "file_type": "code", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pinball_core_physics_physicsworld_physicsworld", "label": "PhysicsWorld", "file_type": "code", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pinball_core_physics_contactsolver_contactsolver", "label": "ContactSolver", "file_type": "code", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pinball_core_physics_rigidbody_ballstate", "label": "BallState (6-DOF)", "file_type": "code", "source_file": "pinball-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contri