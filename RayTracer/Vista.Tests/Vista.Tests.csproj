<Project Sdk="Microsoft.NET.Sdk">

  <!-- Vista.Tests (vista-plan §8.3 / §9): unit tests for everything in Vista.Core. Plain net10.0 (no GPU,
       no WinForms, no network) so it runs in hosted CI; the GPU renderer is validated separately with
       fixed-seed goldens on the RTX 3070. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Vista.Core/Vista.Core.csproj" />
  </ItemGroup>

</Project>
