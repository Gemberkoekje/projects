# Build stage
FROM node:22-alpine AS build
WORKDIR /app
COPY SpaceTraders/SpaceTraders.WebUI/package*.json ./
RUN npm ci
COPY SpaceTraders/SpaceTraders.WebUI/ .
RUN npm run build

# Runtime stage — nginx serves the static bundle
FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY SpaceTraders/SpaceTraders.WebUI/nginx.conf /etc/nginx/conf.d/default.conf
COPY SpaceTraders/SpaceTraders.WebUI/docker-entrypoint.sh /docker-entrypoint.d/40-runtime-config.sh
RUN chmod +x /docker-entrypoint.d/40-runtime-config.sh
EXPOSE 80
