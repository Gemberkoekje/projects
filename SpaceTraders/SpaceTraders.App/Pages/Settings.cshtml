@page
@model SettingsModel
@{
    ViewData["Title"] = "Settings";
}

<div class="mb-4">
    <h1 class="display-5">Settings</h1>
    <p class="text-muted mb-0">Automation configuration. Changes take effect immediately.</p>
</div>

@if (Model.StatusMessage is not null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card mb-3">
    <div class="card-header">Agent selection</div>
    <div class="card-body">
        <div class="small text-muted mb-2">
            Viewing token: <code>@Model.SelectedAgentToken</code><br />
            Active API token: <code>@Model.ActiveAgentToken</code>
        </div>

        <form method="get" class="row g-2 align-items-end mb-3">
            <div class="col-md-6">
                <label class="form-label">Search agents</label>
                <input class="form-control" type="text" name="search" value="@Model.Search" placeholder="Agent symbol or token" />
            </div>
            <div class="col-auto">
                <button class="btn btn-outline-secondary" type="submit">Search</button>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>Agent</th>
                        <th>Last active</th>
                        <th>Token</th>
                        <th>View</th>
                        <th>Active</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var option in Model.AgentOptions)
                {
                    <tr>
                        <td>
                            @option.AgentSymbol
                            @if (option.IsActive)
                            {
                                <span class="badge bg-success ms-1">active</span>
                            }
                        </td>
                        <td>
                            @(option.LastSeenAt == DateTimeOffset.MinValue
                                ? "Unknown"
                                : option.LastSeenAt.ToLocalTime().ToString("g"))
                        </td>
                        <td><code>@option.Token</code></td>
                        <td>
                            <form method="post" asp-page-handler="SwitchView" class="d-inline">
                                <input type="hidden" name="search" value="@Model.Search" />
                                <input type="hidden" name="agentToken" value="@option.Token" />
                                <button class="btn btn-sm btn-outline-primary" type="submit">View</button>
                            </form>
                        </td>
                        <td>
                            <form method="post" asp-page-handler="SetActiveToken" class="d-inline">
                                <input type="hidden" name="search" value="@Model.Search" />
                                <input type="hidden" name="agentToken" value="@option.Token" />
                                <button class="btn btn-sm btn-warning" type="submit">Set active</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (Model.Settings.Count == 0)
{
    <div class="alert alert-info">No settings available yet for this agent.</div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <table class="table table-striped mb-0">
                <thead>
                    <tr>
                        <th>Key</th>
                        <th>Value</th>
                        <th>Type</th>
                        <th>Description</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var setting in Model.Settings)
                {
                    <tr>
                        <td class="align-middle"><code>@setting.Key</code></td>
                        <td>
                            <form method="post" class="d-flex gap-2">
                                <input type="hidden" name="search" value="@Model.Search" />
                                <input type="hidden" name="key" value="@setting.Key" />
                                <input class="form-control form-control-sm"
                                       type="text"
                                       name="value"
                                       value="@setting.Value"
                                       style="max-width:200px" />
                                <button class="btn btn-sm btn-primary" type="submit">Save</button>
                            </form>
                        </td>
                        <td class="align-middle"><span class="badge bg-secondary">@setting.Type</span></td>
                        <td class="align-middle text-muted small">@setting.Description</td>
                        <td></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
