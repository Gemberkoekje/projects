@page
@model SpaceTraders.App.Pages.Fleet.IndexModel
@{
    ViewData["Title"] = "Fleet";
}

<div class="mb-4">
    <h1 class="display-5">Fleet</h1>
    <p class="text-muted mb-0">Fleet view with role/state/cargo/fuel/cooldown/assignment filters.</p>
</div>

<form method="get" class="card card-body mb-3">
    <div class="row g-2">
        <div class="col-12 col-md-2">
            <label class="form-label">Role</label>
            <input class="form-control form-control-sm" name="RoleFilter" value="@Model.RoleFilter" placeholder="ALL or role" />
        </div>
        <div class="col-12 col-md-2">
            <label class="form-label">State</label>
            <select class="form-select form-select-sm" name="StateFilter">
                <option value="ALL" selected="@(Model.StateFilter == "ALL" ? "selected" : null)">ALL</option>
                <option value="DOCKED" selected="@(Model.StateFilter == "DOCKED" ? "selected" : null)">DOCKED</option>
                <option value="IN_ORBIT" selected="@(Model.StateFilter == "IN_ORBIT" ? "selected" : null)">IN_ORBIT</option>
                <option value="IN_TRANSIT" selected="@(Model.StateFilter == "IN_TRANSIT" ? "selected" : null)">IN_TRANSIT</option>
            </select>
        </div>
        <div class="col-12 col-md-2">
            <label class="form-label">Cargo</label>
            <select class="form-select form-select-sm" name="CargoFilter">
                <option value="ALL" selected="@(Model.CargoFilter == "ALL" ? "selected" : null)">ALL</option>
                <option value="EMPTY" selected="@(Model.CargoFilter == "EMPTY" ? "selected" : null)">EMPTY</option>
                <option value="LOADED" selected="@(Model.CargoFilter == "LOADED" ? "selected" : null)">LOADED</option>
                <option value="FULL" selected="@(Model.CargoFilter == "FULL" ? "selected" : null)">FULL</option>
            </select>
        </div>
        <div class="col-12 col-md-2">
            <label class="form-label">Fuel</label>
            <select class="form-select form-select-sm" name="FuelFilter">
                <option value="ALL" selected="@(Model.FuelFilter == "ALL" ? "selected" : null)">ALL</option>
                <option value="LOW" selected="@(Model.FuelFilter == "LOW" ? "selected" : null)">LOW (&lt;25%)</option>
                <option value="MEDIUM" selected="@(Model.FuelFilter == "MEDIUM" ? "selected" : null)">MEDIUM</option>
                <option value="HIGH" selected="@(Model.FuelFilter == "HIGH" ? "selected" : null)">HIGH (&gt;75%)</option>
            </select>
        </div>
        <div class="col-12 col-md-2">
            <label class="form-label">Cooldown</label>
            <select class="form-select form-select-sm" name="CooldownFilter">
                <option value="ALL" selected="@(Model.CooldownFilter == "ALL" ? "selected" : null)">ALL</option>
                <option value="READY" selected="@(Model.CooldownFilter == "READY" ? "selected" : null)">READY</option>
                <option value="COOLING" selected="@(Model.CooldownFilter == "COOLING" ? "selected" : null)">COOLING</option>
            </select>
        </div>
        <div class="col-12 col-md-2">
            <label class="form-label">Assignment</label>
            <select class="form-select form-select-sm" name="AssignmentFilter">
                <option value="ALL" selected="@(Model.AssignmentFilter == "ALL" ? "selected" : null)">ALL</option>
                <option value="ASSIGNED" selected="@(Model.AssignmentFilter == "ASSIGNED" ? "selected" : null)">ASSIGNED</option>
                <option value="UNASSIGNED" selected="@(Model.AssignmentFilter == "UNASSIGNED" ? "selected" : null)">UNASSIGNED</option>
            </select>
        </div>
    </div>
    <div class="mt-3">
        <button type="submit" class="btn btn-sm btn-primary">Apply</button>
    </div>
</form>

<div class="card">
    <div class="card-body p-0">
        @if (Model.Ships.Count == 0)
        {
            <div class="p-3 text-muted">No ships matched the selected filters.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-sm mb-0">
                    <thead>
                        <tr>
                            <th>Ship</th>
                            <th>Role</th>
                            <th>State</th>
                            <th>Flight</th>
                            <th>Location</th>
                            <th>Cargo</th>
                            <th>Fuel</th>
                            <th>Cooldown</th>
                            <th>Assignment</th>
                            <th>Sync</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var ship in Model.Ships)
                    {
                        <tr>
                            <td class="text-nowrap"><a asp-page="/Ships/Detail" asp-route-symbol="@ship.Symbol">@ship.Symbol</a></td>
                            <td><code>@ship.Role</code></td>
                            <td><span class="badge bg-secondary">@(ship.IsInTransit ? "IN_TRANSIT" : ship.Status)</span></td>
                            <td><code>@ship.FlightMode</code></td>
                            <td class="text-nowrap">@ship.SystemSymbol<br /><span class="text-muted small">@ship.WaypointSymbol</span></td>
                            <td class="text-nowrap @IndexModel.CargoClass(ship)">@ship.CargoCurrent / @ship.CargoCapacity (@ship.CargoPercent%)</td>
                            <td class="text-nowrap @IndexModel.FuelClass(ship)">@ship.FuelCurrent / @ship.FuelCapacity (@ship.FuelPercent%)</td>
                            <td class="text-nowrap">
                                @if (ship.IsCoolingDown && ship.CooldownExpiresAt.HasValue)
                                {
                                    <span class="text-warning">until @ship.CooldownExpiresAt.Value.ToLocalTime().ToString("g")</span>
                                }
                                else
                                {
                                    <span class="text-muted">ready</span>
                                }
                            </td>
                            <td>@ship.Assignment</td>
                            <td class="text-nowrap text-muted">@ship.LastSyncedAt.ToLocalTime().ToString("g")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
