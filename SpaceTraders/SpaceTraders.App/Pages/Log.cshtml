@page
@model LogModel
@{
    ViewData["Title"] = "Activity Log";
}

<div class="mb-4">
    <h1 class="display-5">Activity Log</h1>
    <p class="text-muted mb-0">Recent automation events.</p>
</div>

@if (Model.Entries.Count == 0)
{
    <div class="alert alert-info">No activity recorded yet.</div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-sm mb-0">
                    <thead>
                        <tr>
                            <th>Time</th>
                            <th>Ship</th>
                            <th>Event</th>
                            <th>Message</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var entry in Model.Entries)
                    {
                        <tr>
                            <td class="text-nowrap">@entry.Timestamp.ToLocalTime().ToString("g")</td>
                            <td>@entry.ShipSymbol</td>
                            <td><span class="badge bg-secondary">@entry.EventType</span></td>
                            <td>@entry.Message</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <nav class="mt-3" aria-label="Activity log pagination">
        <ul class="pagination">
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a class="page-link" asp-page="/Log" asp-route-page="@(Model.CurrentPage - 1)">Previous</a>
            </li>
            <li class="page-item disabled">
                <span class="page-link">Page @Model.CurrentPage</span>
            </li>
            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a class="page-link" asp-page="/Log" asp-route-page="@(Model.CurrentPage + 1)">Next</a>
            </li>
        </ul>
    </nav>
}
