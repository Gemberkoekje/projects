@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="mb-4">
    <h1 class="display-5">SpaceTraders Dashboard</h1>
    <p class="text-muted mb-0">Foundation phase read-only overview from the local cache.</p>
</div>

<div class="mb-3 d-flex gap-2 flex-wrap">
    <a class="btn btn-sm btn-outline-primary" asp-page="/Fleet/Index">Fleet</a>
    <a class="btn btn-sm btn-outline-primary" asp-page="/Systems/Map">System Map</a>
    <a class="btn btn-sm btn-outline-primary" asp-page="/Production/Index">Production Chains</a>
    <a class="btn btn-sm btn-outline-primary" asp-page="/Maintenance/Index">Maintenance</a>
</div>

@if (Model.AlertApiUnavailable || Model.AlertTokenResetMismatch || Model.AlertCacheDivergence || Model.AlertAutomationDisabled || Model.AlertContractDeadlinesApproaching || Model.AlertResetUpcoming)
{
    <div class="alert alert-warning" role="alert">
        <h5 class="mb-2">Operational Alerts</h5>
        <ul class="mb-0">
            @if (Model.AlertApiUnavailable)
            {
                <li>SpaceTraders API is currently unavailable.</li>
            }
            @if (Model.AlertTokenResetMismatch)
            {
                <li>Token reset mismatch detected; operator verification recommended.</li>
            }
            @if (Model.AlertCacheDivergence)
            {
                <li>Cache divergence detected between local state and expected freshness.</li>
            }
            @if (Model.AlertAutomationDisabled)
            {
                <li>Automation is currently disabled.</li>
            }
            @if (Model.AlertContractDeadlinesApproaching)
            {
                <li>One or more contract deadlines are within 6 hours.</li>
            }
            @if (Model.AlertResetUpcoming)
            {
                <li>Server reset is approaching@(string.IsNullOrWhiteSpace(Model.NextResetDisplay) ? "." : $" (next reset: {Model.NextResetDisplay}).")</li>
            }
        </ul>
    </div>
}

@if (Model.Agent is null)
{
    <div class="alert alert-info" role="alert">
        No cached agent data is available yet. Start the API process to bootstrap and sync the account.
    </div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">Agent</div>
                    <div class="fs-4">@Model.Agent.Symbol</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">Credits</div>
                    <div class="fs-4">@Model.Agent.Credits.ToString("N0")</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">Ships</div>
                    <div class="fs-4">@Model.Agent.ShipCount</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">Faction</div>
                    <div class="fs-4">@Model.Agent.StartingFaction</div>
                </div>
            </div>
        </div>
    </div>
}

<div class="card">
    <div class="card-header">
        Ships
    </div>
    <div class="card-body p-0">
        @if (Model.Ships.Count == 0)
        {
            <div class="p-3 text-muted">No ships have been synced yet.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped mb-0">
                    <thead>
                        <tr>
                            <th>Symbol</th>
                            <th>System</th>
                            <th>Waypoint</th>
                            <th>Status</th>
                            <th>Flight Mode</th>
                            <th>Fuel</th>
                            <th>Cargo</th>
                            <th>Last Sync</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var ship in Model.Ships)
                    {
                        <tr>
                            <td><a asp-page="/Ships/Detail" asp-route-symbol="@ship.Symbol">@ship.Symbol</a></td>
                            <td>@ship.SystemSymbol</td>
                            <td>
                                @if (string.IsNullOrWhiteSpace(ship.WaypointSymbol))
                                {
                                    <span>—</span>
                                }
                                else
                                {
                                    <a asp-page="/Waypoints/Detail" asp-route-symbol="@ship.WaypointSymbol">@ship.WaypointSymbol</a>
                                }
                            </td>
                            <td>@ship.Status</td>
                            <td>@ship.FlightMode</td>
                            <td>@ship.FuelCurrent / @ship.FuelCapacity</td>
                            <td>@ship.CargoCurrent / @ship.CargoCapacity</td>
                            <td>@ship.LastSyncedAt.ToLocalTime().ToString("g")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
