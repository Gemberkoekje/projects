@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="mb-4">
    <h1 class="display-5">SpaceTraders Dashboard</h1>
    <p class="text-muted mb-0">Foundation phase read-only overview from the local cache.</p>
</div>

@if (Model.Agent is null)
{
    <div class="alert alert-info" role="alert">
        No cached agent data is available yet. Start the API process to bootstrap and sync the account.
    </div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">Agent</div>
                    <div class="fs-4">@Model.Agent.Symbol</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">Credits</div>
                    <div class="fs-4">@Model.Agent.Credits.ToString("N0")</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">Ships</div>
                    <div class="fs-4">@Model.Agent.ShipCount</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">Faction</div>
                    <div class="fs-4">@Model.Agent.StartingFaction</div>
                </div>
            </div>
        </div>
    </div>
}

<div class="card">
    <div class="card-header">
        Ships
    </div>
    <div class="card-body p-0">
        @if (Model.Ships.Count == 0)
        {
            <div class="p-3 text-muted">No ships have been synced yet.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped mb-0">
                    <thead>
                        <tr>
                            <th>Symbol</th>
                            <th>System</th>
                            <th>Waypoint</th>
                            <th>Status</th>
                            <th>Flight Mode</th>
                            <th>Fuel</th>
                            <th>Last Sync</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var ship in Model.Ships)
                    {
                        <tr>
                            <td>@ship.Symbol</td>
                            <td>@ship.SystemSymbol</td>
                            <td>@ship.WaypointSymbol</td>
                            <td>@ship.Status</td>
                            <td>@ship.FlightMode</td>
                            <td>@ship.FuelCurrent / @ship.FuelCapacity</td>
                            <td>@ship.LastSyncedAt.ToLocalTime().ToString("g")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
