@page "{id}"
@model SpaceTraders.App.Pages.Contracts.DetailModel
@{
    ViewData["Title"] = "Contract Detail";
}

<div class="mb-4 d-flex align-items-center gap-2">
    <a asp-page="/Contracts/Index" class="btn btn-outline-secondary btn-sm">← Contracts</a>
    <h1 class="display-6 mb-0">Contract Detail</h1>
</div>

@if (Model.NotFound)
{
    <div class="alert alert-warning">Contract not found in cache.</div>
}
else
{
    <div class="card mb-3">
        <div class="card-body">
            <div><strong>ID:</strong> <code>@Model.Contract.Id</code></div>
            <div><strong>Type:</strong> @Model.Contract.Type</div>
            <div><strong>Faction:</strong> @Model.Contract.FactionSymbol</div>
            <div><strong>Status:</strong>
                @if (Model.Contract.IsFulfilled)
                {
                    <span class="badge bg-success">Fulfilled</span>
                }
                else if (Model.Contract.IsAccepted)
                {
                    <span class="badge bg-primary">Accepted</span>
                }
                else
                {
                    <span class="badge bg-secondary">Pending</span>
                }
            </div>
            <div><strong>Deadline:</strong> @(Model.Contract.Expiration?.ToLocalTime().ToString("g") ?? "—")</div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-12 col-lg-7">
            <div class="card h-100">
                <div class="card-header">Delivery Progress</div>
                <div class="card-body p-0">
                    @if (Model.Deliverables.Count == 0)
                    {
                        <div class="p-3 text-muted">No deliverables cached for this contract.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-sm mb-0">
                                <thead>
                                    <tr>
                                        <th>Trade Symbol</th>
                                        <th>Destination</th>
                                        <th class="text-end">Required</th>
                                        <th class="text-end">Fulfilled</th>
                                        <th class="text-end">Remaining</th>
                                        <th>Progress</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var item in Model.Deliverables)
                                {
                                    <tr>
                                        <td><code>@item.TradeSymbol</code></td>
                                        <td>@item.DestinationSymbol</td>
                                        <td class="text-end">@item.UnitsRequired</td>
                                        <td class="text-end">@item.UnitsFulfilled</td>
                                        <td class="text-end">@item.RemainingUnits</td>
                                        <td class="text-nowrap">@item.CompletionPercent%</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-5">
            <div class="card h-100">
                <div class="card-header">Assigned Ships</div>
                <div class="card-body p-0">
                    @if (Model.AssignedShips.Count == 0)
                    {
                        <div class="p-3 text-muted">No active assignment linked to this contract.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-sm mb-0">
                                <thead>
                                    <tr>
                                        <th>Ship</th>
                                        <th>Role</th>
                                        <th>Cargo</th>
                                        <th>Destination</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var ship in Model.AssignedShips)
                                {
                                    <tr>
                                        <td><a asp-page="/Ships/Detail" asp-route-symbol="@ship.ShipSymbol">@ship.ShipSymbol</a></td>
                                        <td><code>@ship.Type</code></td>
                                        <td>@ship.CargoSymbol</td>
                                        <td>@ship.DestWaypoint</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}
