@page
@model SpaceTraders.App.Pages.Contracts.IndexModel
@{
    ViewData["Title"] = "Contracts";
}

<div class="mb-4">
    <h1 class="display-5">Contracts</h1>
    <p class="text-muted mb-0">Active and pending contracts from the local cache.</p>
</div>

@if (Model.Contracts.Count == 0)
{
    <div class="alert alert-info">No contracts have been synced yet.</div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped mb-0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Type</th>
                            <th>Faction</th>
                            <th>Deadline</th>
                            <th>Accept By</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var contract in Model.Contracts)
                    {
                        <tr>
                            <td class="text-nowrap"><code>@contract.Id</code></td>
                            <td>@contract.Type</td>
                            <td>@contract.FactionSymbol</td>
                            <td class="text-nowrap">
                                @if (contract.Expiration.HasValue)
                                {
                                    <span class="@(contract.Expiration.Value < DateTimeOffset.UtcNow.AddHours(24) ? "text-danger" : "")">
                                        @contract.Expiration.Value.ToLocalTime().ToString("g")
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-nowrap">
                                @if (contract.DeadlineToAccept.HasValue)
                                {
                                    @contract.DeadlineToAccept.Value.ToLocalTime().ToString("g")
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                @if (contract.IsFulfilled)
                                {
                                    <span class="badge bg-success">Fulfilled</span>
                                }
                                else if (contract.IsAccepted)
                                {
                                    <span class="badge bg-primary">Accepted</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Pending</span>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
