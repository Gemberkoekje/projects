@page
@model ApiUsageModel
@{
    ViewData["Title"] = "API Usage";
}

<div class="mb-4">
    <h1 class="display-5">API Usage</h1>
    <p class="text-muted mb-0">Endpoint calls for the current agent token.</p>
</div>

@if (Model.Entries.Count == 0)
{
    <div class="alert alert-info">No endpoint usage has been recorded yet.</div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-sm mb-0">
                    <thead>
                        <tr>
                            <th>Method</th>
                            <th>Endpoint</th>
                            <th class="text-end">Calls</th>
                            <th>Last Called</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var entry in Model.Entries)
                    {
                        <tr>
                            <td><span class="badge text-bg-secondary">@entry.HttpMethod</span></td>
                            <td><code>@entry.Endpoint</code></td>
                            <td class="text-end">@entry.Calls</td>
                            <td class="text-nowrap text-muted">@entry.LastCalledAt.ToLocalTime().ToString("g")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
