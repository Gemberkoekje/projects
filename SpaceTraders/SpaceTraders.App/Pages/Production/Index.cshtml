@page
@model SpaceTraders.App.Pages.Production.IndexModel
@{
    ViewData["Title"] = "Production Chains";
}

<div class="mb-4">
    <h1 class="display-5">Production Chains</h1>
    <p class="text-muted mb-0">Reference links derived from normalized trade opportunities and supply-chain scoring.</p>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (Model.Links.Count == 0)
        {
            <div class="p-3 text-muted">No production-chain links are available yet.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-sm mb-0">
                    <thead>
                        <tr>
                            <th>Good</th>
                            <th>Buy</th>
                            <th>Sell</th>
                            <th>Buy Type</th>
                            <th>Sell Type</th>
                            <th>Chain</th>
                            <th class="text-end">Score</th>
                            <th class="text-end">Profit/Unit</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var link in Model.Links)
                    {
                        <tr>
                            <td><a asp-page="/Market/Index" asp-route-tradeSymbol="@link.TradeSymbol"><code>@link.TradeSymbol</code></a></td>
                            <td>@link.BuyWaypoint</td>
                            <td>@link.SellWaypoint</td>
                            <td><code>@link.BuyType</code></td>
                            <td><code>@link.SellType</code></td>
                            <td>
                                @if (link.SupportsSupplyChain)
                                {
                                    <span class="badge bg-success">Depth @link.SupplyChainDepth</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Direct</span>
                                }
                            </td>
                            <td class="text-end">@link.RouteScore.ToString("N1")</td>
                            <td class="text-end">@link.ProfitPerUnit.ToString("N0")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
