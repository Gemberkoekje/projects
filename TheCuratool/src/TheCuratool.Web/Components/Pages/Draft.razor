@page "/draft"
@page "/draft/{SessionId:guid}"
@inject DraftSessionState SessionState
@inject NavigationManager Nav

<h1 class="page-title">Draft</h1>

@if (!_isReady)
{
    <p class="panel muted">Loading session...</p>
}
else if (!SessionState.HasCurrentSession)
{
    <p class="panel">No draft session has been started. <a href="setup">Configure a session first ←</a></p>
}
else
{
    var session = SessionState.CurrentSession;
    var remaining = session.Players.Count(p => p.Choice is not PlayerChoice.ChosenChoice);
    var chosen = session.Players.Count(p => p.Choice is PlayerChoice.ChosenChoice);
    var summary = SessionState.CurrentMakeupSummary;

    <div class="panel stack-md">
        <p>
            <strong>Script:</strong> @session.Script.Name
            &mdash; <strong>Players:</strong> @session.PlayerCount
            &mdash; <strong>Status:</strong> @session.Status
        </p>

        <p class="muted">@chosen of @session.PlayerCount players assigned &mdash; @remaining seat(s) remaining.</p>

        @if (!string.IsNullOrWhiteSpace(SessionState.DraftMessage))
        {
            <p class="error-text"><strong>@SessionState.DraftMessage</strong></p>
        }
    </div>

    <div class="draft-grid" style="margin-top: 1rem;">
        <section class="panel stack-md">
            <h2>Player Order</h2>
            <label>
                <InputCheckbox @bind-Value="SessionState.RevealChosenCharacters" /> Reveal chosen characters
            </label>
            <table>
                <thead>
                    <tr>
                        <th>Draft</th>
                        <th>Status</th>
                        <th>Character</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var slot in session.Players.OrderBy(p => p.DraftOrder))
                    {
                        var isCurrent = slot.DraftOrder == SessionState.CurrentPlayerSlot;
                        <tr class="@(isCurrent ? "current-row" : string.Empty)">
                            <td>@slot.DraftOrder</td>
                            <td>
                                @if (slot.IsStAssigned)
                                {
                                    <span title="Storyteller-assigned (unresolved)">ST-assigned</span>
                                }
                                else
                                {
                                    @(slot.IsChosen ? "Chosen" : isCurrent ? "Current" : "Pending")
                                }
                            </td>
                            <td>
                                @if (slot.Choice is PlayerChoice.ChosenChoice chosenSlot)
                                {
                                    if (SessionState.RevealChosenCharacters)
                                    {
                                        @FormatChosenCharacter(chosenSlot, slot.BorrowedAbilityCharacterId)
                                    }
                                    else
                                    {
                                        <em class="muted">hidden</em>
                                    }
                                }
                                else if (slot.IsStAssigned)
                                {
                                    <em class="muted">awaiting ST resolution</em>
                                }
                                else
                                {
                                    <em class="muted">not yet chosen</em>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>

        <section class="panel stack-md">
            <h2>Current Player</h2>
            @if (session.Status == GameStatus.Completed)
            {
                <p class="success-text">Draft completed.</p>
            }
            else
            {
                <p><strong>Slot:</strong> @SessionState.CurrentPlayerSlot</p>
                <div class="action-row">
                    <button @onclick="OfferRandom">Random 3</button>
                    <button @onclick="BeginCurate">Curate</button>
                </div>

                @if (SessionState.IsCuratingOffer)
                {
                    var roleCandidates = SessionState.GetCurateRoleCandidates();
                    var selectedRoleIsSpecial = SessionState.IsCuratedSpecialRole(SessionState.CuratedRoleCharacterId);
                    var disguiseCandidates = SessionState.GetCurateDisguiseCandidates(SessionState.CuratedRoleCharacterId);
                    var canAddCuratedRole = !string.IsNullOrWhiteSpace(SessionState.CuratedRoleCharacterId)
                        && (!selectedRoleIsSpecial || !string.IsNullOrWhiteSpace(SessionState.CuratedDisguiseCharacterId));

                    <p><strong>Curate up to 3 characters:</strong></p>
                    <div class="selection-box" style="margin-top:0.75rem;">
                        <div class="action-row">
                            <select @bind="SessionState.CuratedRoleCharacterId">
                                <option value="">Select role</option>
                                @foreach (var candidate in roleCandidates)
                                {
                                    <option value="@candidate.Id">@candidate.DisplayName (@candidate.Type)</option>
                                }
                            </select>

                            @if (selectedRoleIsSpecial)
                            {
                                <select @bind="SessionState.CuratedDisguiseCharacterId" disabled="@(disguiseCandidates.Count == 0)">
                                    <option value="">@GetCurateSecondarySelectorPlaceholder(SessionState.CuratedRoleCharacterId)</option>
                                    @foreach (var candidate in disguiseCandidates)
                                    {
                                        <option value="@candidate.Id">@candidate.DisplayName</option>
                                    }
                                </select>
                            }

                            <button @onclick="AddCuratedRole" disabled="@(!canAddCuratedRole)">Add role</button>
                        </div>
                    </div>

                    @if (SessionState.CuratedOfferSelection.Count > 0)
                    {
                        <p><strong>Current curated options:</strong></p>
                        <ul>
                            @foreach (var option in SessionState.CuratedOfferSelection)
                            {
                                var curatedWarning = SessionState.GetTargetReachabilityWarning(GetPresentedCharacterId(option));
                                <li>
                                    @FormatOfferOption(option)
                                    @if (!string.IsNullOrEmpty(curatedWarning))
                                    {
                                        <span class="error-text" title="@curatedWarning"> ⚠ @curatedWarning</span>
                                    }
                                </li>
                            }
                        </ul>
                    }

                    <div>
                        <button @onclick="ConfirmCurated">Confirm Curated Offer</button>
                    </div>
                }

                @if (SessionState.CurrentOfferOptions.Count > 0)
                {
                    <h3>Offered Characters</h3>
                    <p class="warning-text">
                        <strong>Player-facing prompt:</strong> only read the role name on the button to the player.
                        Any extra text shown below is Storyteller-only guidance.
                    </p>
                    <div class="action-row offer-options-row">
                        @foreach (var offer in SessionState.CurrentOfferOptions)
                        {
                            <div class="offer-option">
                                <button class="offer-button" @onclick="() => Pick(GetPresentedCharacterId(offer))">@GetPlayerFacingOfferLabel(offer)</button>
                                <div class="offer-meta">@GetOfferButtonMetaLabel(offer)</div>
                            </div>
                        }
                    </div>
                    <ul class="error-text">
                        @foreach (var offer in SessionState.CurrentOfferOptions)
                        {
                            var offeredWarning = SessionState.GetTargetReachabilityWarning(GetPresentedCharacterId(offer));
                            if (!string.IsNullOrEmpty(offeredWarning))
                            {
                                <li>⚠ @FormatOfferOption(offer): @offeredWarning</li>
                            }
                        }
                    </ul>
                }
                else
                {
                    <p class="muted">No active offer for this slot yet.</p>
                }
            }
        </section>

        <section class="panel stack-md">
            <h2>Makeup Summary</h2>
            <p>
                Townsfolk: @summary.CurrentCounts.Townsfolk
                · Outsiders: @summary.CurrentCounts.Outsiders
                · Minions: @summary.CurrentCounts.Minions
                · Demons: @summary.CurrentCounts.Demons
            </p>
            @if (summary.TargetCounts.Count > 0)
            {
                <p><strong>Targets:</strong></p>
                <label>
                    <input type="checkbox"
                           checked="@SessionState.AllTargetsSelected"
                           @onchange="OnToggleAllTargets" />
                    Select all
                </label>
                <ul>
                    @foreach (var target in summary.TargetCounts)
                    {
                        var current = target;
                        <li>
                            <label>
                                <input type="checkbox"
                                       checked="@SessionState.IsTargetSelected(current)"
                                       @onchange="e => OnToggleTarget(current, e)" />
                                @current.Townsfolk T / @current.Outsiders O / @current.Minions M / @current.Demons D
                            </label>
                        </li>
                    }
                </ul>
            }
        </section>
    </div>

    @if (session.Status == GameStatus.Completed)
    {
        <p style="margin-top: 1rem;"><a href="@($"/summary/{session.Id}")">View Summary →</a></p>
    }
}

@code {
    [Parameter]
    public Guid SessionId { get; set; }

    private bool _isReady;

    protected override async Task OnParametersSetAsync()
    {
        if (SessionId != Guid.Empty)
        {
            await SessionState.EnsureSessionLoadedAsync(SessionId);
        }

        _isReady = true;
    }

    private void OfferRandom()
    {
        SessionState.OfferRandomThree();
    }

    private void BeginCurate()
    {
        SessionState.BeginCuratedOffer();
    }

    private async Task ConfirmCurated()
    {
        await SessionState.ConfirmCuratedOfferAsync();
    }

    private void AddCuratedRole()
    {
        SessionState.AddCuratedRoleOption(SessionState.CuratedRoleCharacterId, SessionState.CuratedDisguiseCharacterId);
    }

    private void OnToggleAllTargets(ChangeEventArgs e)
    {
        var selectAll = e.Value is bool value && value;
        SessionState.ToggleAllTargets(selectAll);
    }

    private void OnToggleTarget(SetupCounts target, ChangeEventArgs e)
    {
        var isSelected = e.Value is bool value && value;
        SessionState.SetTargetSelected(target, isSelected);
    }

    private string FormatChosenCharacter(PlayerChoice.ChosenChoice chosen, string borrowedAbilityCharacterId)
    {
        var shownCharacterId = (chosen.HiddenFlags.IsDrunk || chosen.HiddenFlags.IsLunatic)
            && !string.IsNullOrWhiteSpace(chosen.DisguiseCharacterId)
                ? chosen.DisguiseCharacterId
                : chosen.CharacterId;
        var shownDefinition = ResolveCharacter(shownCharacterId);
        var effectiveDefinition = ResolveCharacter(chosen.CharacterId);
        var effectiveType = chosen.HiddenFlags.IsDrunk
            ? CharacterType.Outsider
            : chosen.HiddenFlags.IsLunatic
                ? CharacterType.Outsider
                : effectiveDefinition.Type;
        var hiddenRoleLabel = GetHiddenRoleLabel(chosen.CharacterId, chosen.HiddenFlags);
        var baseName = hiddenRoleLabel.Length == 0
            ? shownDefinition.DisplayName
            : $"{shownDefinition.DisplayName} ({hiddenRoleLabel})";

        if (!string.IsNullOrWhiteSpace(borrowedAbilityCharacterId))
        {
            var borrowedDefinition = ResolveCharacter(borrowedAbilityCharacterId);
            return $"{baseName} ({borrowedDefinition.DisplayName}) ({effectiveType})";
        }

        return $"{baseName} ({effectiveType})";
    }

    private string GetPlayerFacingOfferLabel(OfferOption option)
    {
        var presentedId = GetPresentedCharacterId(option);
        if (SessionState.CurrentSession.IsLegionGame
            && (string.Equals(presentedId, "evil", StringComparison.OrdinalIgnoreCase)
                || option.HiddenFlags.IsLunatic))
        {
            return "Evil";
        }

        var presented = SessionState.CurrentSession.Script.Characters.FirstOrDefault(character =>
            string.Equals(character.Id, presentedId, StringComparison.OrdinalIgnoreCase));

        return presented?.DisplayName ?? presentedId;
    }

    private string GetOfferStorytellerDetails(OfferOption option)
    {
        var presentedId = GetPresentedCharacterId(option);
        var presented = SessionState.CurrentSession.Script.Characters.FirstOrDefault(character =>
            string.Equals(character.Id, presentedId, StringComparison.OrdinalIgnoreCase));

        var displayType = presented?.Type ?? CharacterType.Unknown;
        var hiddenRoleLabel = GetHiddenRoleLabel(option.CharacterId, option.HiddenFlags);

        if (hiddenRoleLabel.Length > 0)
        {
            return $"hidden role: {hiddenRoleLabel}; shown type: {displayType}";
        }

        if (!string.IsNullOrWhiteSpace(option.BorrowedAbilityCharacterId))
        {
            var borrowedDefinition = ResolveCharacter(option.BorrowedAbilityCharacterId);
            return $"borrowed ability: {borrowedDefinition.DisplayName}; shown type: {displayType}";
        }

        return $"shown type: {displayType}";
    }

    private string FormatOfferOption(OfferOption option)
    {
        var displayName = GetPlayerFacingOfferLabel(option);
        var meta = GetOfferButtonMetaLabel(option);
        return string.IsNullOrWhiteSpace(meta)
            ? displayName
            : $"{displayName} {meta}";
    }

    private string GetOfferButtonMetaLabel(OfferOption option)
    {
        if (SessionState.CurrentSession.IsLegionGame
            && (string.Equals(GetPresentedCharacterId(option), "evil", StringComparison.OrdinalIgnoreCase)
                || option.HiddenFlags.IsLunatic))
        {
            return "(legion) (demon)";
        }

        var hiddenRoleLabel = GetHiddenRoleLabel(option.CharacterId, option.HiddenFlags);
        var effectiveType = option.HiddenFlags.IsDrunk || option.HiddenFlags.IsLunatic
            ? CharacterType.Outsider
            : ResolveCharacter(GetPresentedCharacterId(option)).Type;

        var parts = new List<string>();

        if (hiddenRoleLabel.Length > 0)
        {
            parts.Add(hiddenRoleLabel.ToLowerInvariant());
        }

        if (!string.IsNullOrWhiteSpace(option.BorrowedAbilityCharacterId))
        {
            var borrowedDefinition = ResolveCharacter(option.BorrowedAbilityCharacterId);
            parts.Add(borrowedDefinition.DisplayName.ToLowerInvariant());
        }

        parts.Add(effectiveType.ToString().ToLowerInvariant());

        return string.Join(" ", parts.Select(part => $"({part})"));
    }

    private static string GetPresentedCharacterId(OfferOption option)
    {
        return string.IsNullOrWhiteSpace(option.DisguiseCharacterId)
            ? option.CharacterId
            : option.DisguiseCharacterId;
    }

    private static string GetHiddenRoleLabel(string characterId, HiddenFlags hiddenFlags)
    {
        if (!hiddenFlags.IsDrunk && !hiddenFlags.IsLunatic)
        {
            return string.Empty;
        }

        if (string.Equals(characterId, "hermit", StringComparison.OrdinalIgnoreCase))
        {
            return "hermit";
        }

        return hiddenFlags.IsDrunk ? "drunk" : "lunatic";
    }

    private CharacterDefinition ResolveCharacter(string characterId)
    {
        return SessionState.CurrentSession.Script.Characters.FirstOrDefault(character =>
            string.Equals(character.Id, characterId, StringComparison.OrdinalIgnoreCase))
            ?? SessionState.CurrentSession.Script.OutOfScriptCharacters.FirstOrDefault(character =>
                string.Equals(character.Id, characterId, StringComparison.OrdinalIgnoreCase))
            ?? SessionState.LoadResult.Script.Characters.FirstOrDefault(character =>
                string.Equals(character.Id, characterId, StringComparison.OrdinalIgnoreCase))
            ?? new CharacterDefinition(characterId, characterId, CharacterType.Unknown, Array.Empty<ISetupRule>(), Array.Empty<IAvailabilityConstraint>(), true, false, false);
    }

    private async Task Pick(string characterId)
    {
        await SessionState.RecordChoiceAsync(characterId);
    }

    private static string GetCurateSecondarySelectorPlaceholder(string roleCharacterId)
    {
        if (string.Equals(roleCharacterId, "drunk", StringComparison.OrdinalIgnoreCase))
        {
            return "Shown as townsfolk...";
        }

        if (string.Equals(roleCharacterId, "lunatic", StringComparison.OrdinalIgnoreCase))
        {
            return "Shown as demon...";
        }

        if (string.Equals(roleCharacterId, "alchemist", StringComparison.OrdinalIgnoreCase)
            || string.Equals(roleCharacterId, "boffin", StringComparison.OrdinalIgnoreCase))
        {
            return "Borrowed ability...";
        }

        return "Select option...";
    }
}
