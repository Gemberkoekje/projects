@page "/summary"
@page "/summary/{SessionId:guid}"
@inject DraftSessionState SessionState

<h1 class="page-title">Session Summary</h1>

@if (!_isReady)
{
    <p class="panel muted">Loading session...</p>
}
else if (!SessionState.HasCurrentSession)
{
    <p class="panel">No completed session is available. <a href="/">Start a new session ←</a></p>
}
else
{
    var session = SessionState.CurrentSession;
    var summary = SessionState.CurrentMakeupSummary;

    var dynamicOptionsByOrder = session.Players
        .Where(p => p.Choice is PlayerChoice.ChosenChoice && string.IsNullOrEmpty(p.BorrowedAbilityCharacterId))
        .ToDictionary(p => p.DraftOrder, p => SessionState.GetDynamicAbilityOptions(p.DraftOrder));

    @if (summary.RequiresStorytellerSetupConfirmation)
    {
        var unassignedCount = dynamicOptionsByOrder.Count(kv => kv.Value.Count > 0);
        <div class="panel" style="border-left: 4px solid orange; margin-bottom: 1rem;">
            <strong>⚠ Confirm effective counts</strong> — @unassignedCount borrowed @(unassignedCount == 1 ? "ability" : "abilities") still unassigned.
        </div>
    }

    <div class="panel stack-md">
        <p><strong>Script:</strong> @(string.IsNullOrWhiteSpace(session.Script.Name) ? "(unnamed)" : session.Script.Name)</p>
        <p><strong>Status:</strong> @session.Status</p>
        <p><strong>Players:</strong> @session.PlayerCount</p>

        <p>
            <strong>Final Makeup:</strong>
            Townsfolk @summary.CurrentCounts.Townsfolk,
            Outsiders @summary.CurrentCounts.Outsiders,
            Minions @summary.CurrentCounts.Minions,
            Demons @summary.CurrentCounts.Demons
        </p>
    </div>

    <section class="panel" style="margin-top: 1rem;">
        <h2>Final Assignments</h2>
        <table>
            <thead>
                <tr>
                    <th>Draft Order</th>
                    <th>Character</th>
                    <th>Hidden Flags</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var slot in session.Players.OrderBy(p => p.DraftOrder))
                {
                    <tr>
                        <td>@slot.DraftOrder</td>
                        <td>
                            @if (slot.Choice is PlayerChoice.ChosenChoice chosen)
                            {
                                @FormatChosenCharacter(chosen, slot.BorrowedAbilityCharacterId)
                            }
                            else
                            {
                                <em class="muted">unassigned</em>
                            }
                        </td>
                        <td>
                            @if (slot.Choice is PlayerChoice.ChosenChoice c)
                            {
                                @(c.HiddenFlags.IsDrunk ? "Drunk " : string.Empty)
                                @(c.HiddenFlags.IsLunatic ? "Lunatic" : string.Empty)
                                @(!c.HiddenFlags.IsDrunk && !c.HiddenFlags.IsLunatic ? "—" : string.Empty)
                            }
                        </td>
                    </tr>
                    @if (slot.Choice is PlayerChoice.ChosenChoice slotChosen && string.IsNullOrEmpty(slot.BorrowedAbilityCharacterId))
                    {
                        if (dynamicOptionsByOrder.TryGetValue(slot.DraftOrder, out var abilityOptions) && abilityOptions.Count > 0)
                        {
                            <tr>
                                <td></td>
                                <td colspan="2">
                                    <strong>Assign borrowed ability:</strong>
                                    <div class="action-row">
                                        @foreach (var option in abilityOptions)
                                        {
                                            if (option.IsAvailable)
                                            {
                                                <button @onclick="() => PickDynamicAbility(slot.DraftOrder, option.AbilityCharacterId)">@option.DisplayName</button>
                                            }
                                            else
                                            {
                                                <button disabled title="@option.UnavailableReason">@option.DisplayName</button>
                                            }
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>
    </section>

    <section class="panel stack-md" style="margin-top: 1rem;">
        <h2>Export JSON</h2>
        <p class="muted">Copy this payload to save the final grimoire state.</p>
        <textarea readonly rows="18" style="width: 100%; font-family: Consolas, monospace;">@SessionState.BuildSummaryJson()</textarea>
    </section>
}

@code {
    [Parameter]
    public Guid SessionId { get; set; }

    private bool _isReady;

    protected override async Task OnParametersSetAsync()
    {
        if (SessionId != Guid.Empty)
        {
            await SessionState.EnsureSessionLoadedAsync(SessionId);
        }

        _isReady = true;
    }

    private static string FormatChosenCharacter(PlayerChoice.ChosenChoice chosen, string borrowedAbilityCharacterId)
    {
        var baseName = chosen.HiddenFlags.IsDrunk
            ? $"{chosen.CharacterId} (drunk)"
            : chosen.HiddenFlags.IsLunatic
                ? $"{chosen.CharacterId} (lunatic)"
                : chosen.CharacterId;

        if (!string.IsNullOrEmpty(borrowedAbilityCharacterId))
        {
            return $"{baseName} (as {borrowedAbilityCharacterId})";
        }

        return baseName;
    }

    private async Task PickDynamicAbility(int draftOrder, string abilityCharacterId)
    {
        await SessionState.AssignDynamicAbilityAsync(draftOrder, abilityCharacterId);
    }
}
