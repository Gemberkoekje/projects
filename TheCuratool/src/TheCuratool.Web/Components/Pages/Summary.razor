@page "/summary"
@page "/summary/{SessionId:guid}"
@inject DraftSessionState SessionState

<h1 class="page-title">Session Summary</h1>

@if (!_isReady)
{
    <p class="panel muted">Loading session...</p>
}
else if (!SessionState.HasCurrentSession)
{
    <p class="panel">No completed session is available. <a href="">Start a new session ←</a></p>
}
else
{
    var session = SessionState.CurrentSession;
    var summary = SessionState.CurrentMakeupSummary;

    var dynamicOptionsByOrder = session.Players
        .Where(p => p.Choice is PlayerChoice.ChosenChoice && string.IsNullOrEmpty(p.BorrowedAbilityCharacterId))
        .ToDictionary(p => p.DraftOrder, p => SessionState.GetDynamicAbilityOptions(p.DraftOrder));

    @if (summary.RequiresStorytellerSetupConfirmation)
    {
        var unassignedCount = dynamicOptionsByOrder.Count(kv => kv.Value.Count > 0);
        <div class="panel" style="border-left: 4px solid orange; margin-bottom: 1rem;">
            <strong>⚠ Confirm effective counts</strong> — @unassignedCount borrowed @(unassignedCount == 1 ? "ability" : "abilities") still unassigned.
        </div>
    }

    <div class="panel stack-md">
        <p><strong>Script:</strong> @(string.IsNullOrWhiteSpace(session.Script.Name) ? "(unnamed)" : session.Script.Name)</p>
        <p><strong>Status:</strong> @session.Status</p>
        <p><strong>Players:</strong> @session.PlayerCount</p>

        <p>
            <strong>Final Makeup:</strong>
            Townsfolk @summary.CurrentCounts.Townsfolk,
            Outsiders @summary.CurrentCounts.Outsiders,
            Minions @summary.CurrentCounts.Minions,
            Demons @summary.CurrentCounts.Demons
        </p>
    </div>

    <section class="panel" style="margin-top: 1rem;">
        <h2>Final Assignments</h2>
        <table>
            <thead>
                <tr>
                    <th>Draft Order</th>
                    <th>Character</th>
                    <th>Hidden Flags</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var slot in session.Players.OrderBy(p => p.DraftOrder))
                {
                    <tr>
                        <td>@slot.DraftOrder</td>
                        <td>
                            @if (slot.Choice is PlayerChoice.ChosenChoice chosen)
                            {
                                @FormatChosenCharacter(chosen, slot.BorrowedAbilityCharacterId)
                            }
                            else if (slot.IsStAssigned)
                            {
                                <em class="muted">ST-assigned (awaiting resolution)</em>
                            }
                            else
                            {
                                <em class="muted">unassigned</em>
                            }
                        </td>
                        <td>
                            @if (slot.Choice is PlayerChoice.ChosenChoice c)
                            {
                                @(c.HiddenFlags.IsDrunk ? "Drunk " : string.Empty)
                                @(c.HiddenFlags.IsLunatic ? "Lunatic" : string.Empty)
                                @(!c.HiddenFlags.IsDrunk && !c.HiddenFlags.IsLunatic ? "—" : string.Empty)
                            }
                        </td>
                    </tr>
                    @if (slot.IsStAssigned && slot.Choice is not PlayerChoice.ChosenChoice)
                    {
                        <tr>
                            <td></td>
                            <td colspan="2">
                                <strong>Resolve ST-assigned slot:</strong>
                                <div>
                                    <select @onchange="args => _selectedResolutionCharacterId[slot.DraftOrder] = args.Value?.ToString() ?? string.Empty">
                                        <option value="">-- Select character --</option>
                                        @foreach (var character in SessionState.CurrentValidCharacters.OrderBy(c => c.DisplayName))
                                        {
                                            <option value="@character.Id">@character.DisplayName (@character.Type)</option>
                                        }
                                    </select>
                                    <button @onclick="() => ResolveSlot(slot.DraftOrder)">Confirm</button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </section>

    <section class="panel stack-md" style="margin-top: 1rem;">
        <h2>Export JSON</h2>
        <p class="muted">Copy this payload to save the final grimoire state.</p>
        <textarea readonly rows="18" style="width: 100%; font-family: Consolas, monospace;">@SessionState.BuildSummaryJson()</textarea>
    </section>
}

@code {
    [Parameter]
    public Guid SessionId { get; set; }

    private bool _isReady;
    private readonly Dictionary<int, string> _selectedResolutionCharacterId = new();

    protected override async Task OnParametersSetAsync()
    {
        if (SessionId != Guid.Empty)
        {
            await SessionState.EnsureSessionLoadedAsync(SessionId);
        }

        _isReady = true;
    }

    private string FormatChosenCharacter(PlayerChoice.ChosenChoice chosen, string borrowedAbilityCharacterId)
    {
        var shownCharacterId = (chosen.HiddenFlags.IsDrunk || chosen.HiddenFlags.IsLunatic)
            && !string.IsNullOrWhiteSpace(chosen.DisguiseCharacterId)
                ? chosen.DisguiseCharacterId
                : chosen.CharacterId;
        var shownDefinition = ResolveCharacter(shownCharacterId);
        var effectiveDefinition = ResolveCharacter(chosen.CharacterId);
        var effectiveType = chosen.HiddenFlags.IsDrunk
            ? CharacterType.Outsider
            : chosen.HiddenFlags.IsLunatic
                ? CharacterType.Outsider
                : effectiveDefinition.Type;
        var hiddenRoleLabel = GetHiddenRoleLabel(chosen.CharacterId, chosen.HiddenFlags);
        var baseName = hiddenRoleLabel.Length == 0
            ? shownDefinition.DisplayName
            : $"{shownDefinition.DisplayName} ({hiddenRoleLabel})";

        if (!string.IsNullOrWhiteSpace(borrowedAbilityCharacterId))
        {
            var borrowedDefinition = ResolveCharacter(borrowedAbilityCharacterId);
            return $"{baseName} ({borrowedDefinition.DisplayName}) ({effectiveType})";
        }

        return $"{baseName} ({effectiveType})";
    }

    private static string GetHiddenRoleLabel(string characterId, HiddenFlags hiddenFlags)
    {
        if (!hiddenFlags.IsDrunk && !hiddenFlags.IsLunatic)
        {
            return string.Empty;
        }

        if (string.Equals(characterId, "hermit", StringComparison.OrdinalIgnoreCase))
        {
            return "hermit";
        }

        return hiddenFlags.IsDrunk ? "drunk" : "lunatic";
    }

    private CharacterDefinition ResolveCharacter(string characterId)
    {
        return SessionState.CurrentSession.Script.Characters.FirstOrDefault(character =>
            string.Equals(character.Id, characterId, StringComparison.OrdinalIgnoreCase))
            ?? SessionState.CurrentSession.Script.OutOfScriptCharacters.FirstOrDefault(character =>
                string.Equals(character.Id, characterId, StringComparison.OrdinalIgnoreCase))
            ?? SessionState.LoadResult.Script.Characters.FirstOrDefault(character =>
                string.Equals(character.Id, characterId, StringComparison.OrdinalIgnoreCase))
            ?? new CharacterDefinition(characterId, characterId, CharacterType.Unknown, Array.Empty<ISetupRule>(), Array.Empty<IAvailabilityConstraint>(), true, false, false);
    }

    private async Task ResolveSlot(int draftOrder)
    {
        if (!_selectedResolutionCharacterId.TryGetValue(draftOrder, out var characterId) || string.IsNullOrWhiteSpace(characterId))
        {
            return;
        }

        // Determine if this is an evil slot or minion slot based on what was chosen
        var session = SessionState.CurrentSession;
        var slot = session.Players.FirstOrDefault(p => p.DraftOrder == draftOrder);
        if (slot is null)
        {
            return;
        }

        var isEvilSlot = slot.Choice is PlayerChoice.ChosenChoice chosen
            && string.Equals(chosen.CharacterId, "evil", StringComparison.OrdinalIgnoreCase);

        if (isEvilSlot)
        {
            await SessionState.ResolveEvilSlotAsync(draftOrder, characterId, new HiddenFlags(false, false));
        }
        else
        {
            // It's a minion slot
            await SessionState.ResolveMinionSlotAsync(draftOrder, characterId);
        }

        // Clear the selection
        if (_selectedResolutionCharacterId.ContainsKey(draftOrder))
        {
            _selectedResolutionCharacterId[draftOrder] = string.Empty;
        }
    }
}
