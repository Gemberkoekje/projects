# IronFlag ignore rules.
#
# NOTE: the workspace-root C:/git/projects/.gitignore is the GitHub Visual Studio
# template, and two of its rules are actively harmful to a Unity project:
#
#   *.meta            -> would drop every Unity .meta file, orphaning asset GUIDs
#                        and breaking every prefab and scene reference on clone
#   **/[Pp]ackages/*  -> would drop unity/Packages/manifest.json, i.e. the whole
#                        package set the project depends on
#
# Rules in this file win because it sits deeper in the tree, so both are undone
# below. Do not remove those negations.

# -- Undo the harmful root rules ---------------------------------------------
!*.meta
!unity/Packages/manifest.json
!unity/Packages/packages-lock.json

# -- Unity generated output ---------------------------------------------------
unity/[Ll]ibrary/
unity/[Tt]emp/
unity/[Oo]bj/
unity/[Bb]uild/
unity/[Bb]uilds/
unity/[Ll]ogs/
unity/[Uu]ser[Ss]ettings/
unity/[Mm]emoryCaptures/
unity/[Rr]ecordings/
unity/.vsconfig

# Solution and project files are regenerated by the editor from the asmdefs.
unity/*.csproj
unity/*.sln
unity/*.slnx
unity/*.unityproj
unity/*.suo
unity/*.user
unity/*.userprefs
unity/*.pidb
unity/*.booproj
unity/*.svd
unity/*.pdb
unity/*.mdb
unity/*.opendb
unity/*.VC.db

# Crash reports and asset-store leftovers.
unity/sysinfo.txt
unity/crashlytics-build.properties
unity/[Aa]ssets/[Aa]ssetStoreTools*
unity/[Aa]ssets/[Pp]lugins/[Ee]ditor/JetBrains*

# -- Blender ------------------------------------------------------------------
# Assets are built from Python, not from saved .blend files; a stray .blend is a
# working file, never the source of truth.
blender/**/*.blend
blender/**/*.blend1
blender/**/__pycache__/

# Exported .glb files ARE committed: their Unity .meta files carry the GUIDs that
# prefabs and scenes reference, so regenerating them per clone would break those
# references. Rebuild with blender/build.ps1 and commit the result.

# -- Claude Code agent state ---------------------------------------------------
# Local session/worktree state for the Claude Code CLI. Not project content, and a
# worktree checkout under here can contain its own nested .git — never commit it.
.claude/

# -- Headless verification output ---------------------------------------------
# The -executeMethod renders and -runTests results are evidence, not sources.
# Renders land wherever -sandboxOutput points, which the notes say is the repo
# root. Test results land relative to -projectPath, because Unity changes its
# working directory to it - so they turn up inside unity/ however they were run.
/*.png
/editmode.xml
/playmode.xml
/unity/editmode.xml
/unity/playmode.xml
