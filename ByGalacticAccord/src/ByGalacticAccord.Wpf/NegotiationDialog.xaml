<Window x:Class="ByGalacticAccord.Wpf.NegotiationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Negotiation" Width="470" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#12182A" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1B2438" />
            <Setter Property="Foreground" Value="#E6EDF6" />
            <Setter Property="BorderBrush" Value="#26304A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="16">
        <TextBlock x:Name="TitleText" Foreground="#F2C85E" FontWeight="Bold" FontSize="15" TextWrapping="Wrap" />
        <TextBlock x:Name="RouteText" Foreground="#8A97AD" Margin="0,2,0,0" TextWrapping="Wrap" />
        <TextBlock x:Name="TermsText" Foreground="#8A97AD" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12" />

        <Border Background="#0E1422" BorderBrush="#26304A" BorderThickness="1" CornerRadius="6"
                Padding="12" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Foreground="#8A97AD" FontSize="11" Text="THEIR CURRENT OFFER" />
                <TextBlock x:Name="OfferText" Foreground="#5EC8F2" FontWeight="Bold" FontSize="22" />
                <TextBlock x:Name="TellText" Foreground="#C4CEDC" FontStyle="Italic" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <StackPanel x:Name="DealPanel" Margin="0,12,0,0">
            <TextBlock Foreground="#8A97AD" FontSize="11" Text="YOUR ASK (₡)" />
            <TextBox x:Name="AskBox" Background="#0E1422" Foreground="#E6EDF6" BorderBrush="#26304A"
                     Padding="6,4" Margin="0,3,0,0" FontSize="14" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Counter" Click="OnCounter" />
                <Button Content="Accept their offer" Click="OnAcceptOffer" />
                <Button Content="Walk away" Click="OnWalk" />
            </StackPanel>
        </StackPanel>

        <TextBlock x:Name="ResultText" Foreground="#6FC07A" Margin="0,12,0,0" TextWrapping="Wrap" FontWeight="SemiBold" />
        <Button x:Name="CloseBtn" Content="Close" Click="OnClose" HorizontalAlignment="Right"
                Margin="0,12,0,0" Visibility="Collapsed" />
    </StackPanel>
</Window>
