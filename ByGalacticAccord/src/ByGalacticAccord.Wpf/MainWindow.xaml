<Window x:Class="ByGalacticAccord.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="By Galactic Accord" Height="820" Width="1366"
        Background="#0B0F1A" FontFamily="Segoe UI" UseLayoutRounding="True">

    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#E6EDF6" />
        <SolidColorBrush x:Key="Muted" Color="#8A97AD" />
        <SolidColorBrush x:Key="Panel" Color="#12182A" />
        <SolidColorBrush x:Key="PanelEdge" Color="#26304A" />
        <SolidColorBrush x:Key="Accent" Color="#5EC8F2" />
        <SolidColorBrush x:Key="Gold" Color="#F2C85E" />

        <Style x:Key="Header" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,6,0,4" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#1B2438" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelEdge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="PanelBox" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelEdge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8" />
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Margin="10" Background="#0B0F1A">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="160" />
        </Grid.RowDefinitions>

        <!-- top bar -->
        <Border Grid.Row="0" Style="{StaticResource PanelBox}" Margin="0,0,0,8">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="BY GALACTIC ACCORD" Foreground="{StaticResource Gold}"
                               FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock x:Name="TickText" Foreground="{StaticResource Muted}" Margin="16,0,0,0"
                               VerticalAlignment="Center" Text="tick 0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="CreditsText" Foreground="{StaticResource Accent}" FontWeight="Bold"
                               FontSize="15" VerticalAlignment="Center" Margin="0,0,18,0" Text="₡0" />
                    <Button x:Name="PauseBtn" Content="❚❚ Pause" Click="OnPause" />
                    <Button x:Name="PlayBtn" Content="▶ Play" Click="OnPlay" />
                    <Button x:Name="FastBtn" Content="▶▶ Fast" Click="OnFast" />
                    <TextBlock x:Name="SpeedText" Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                               Margin="8,0,0,0" Text="paused" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- main area: map + right panel -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="384" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelBox}" Margin="0,0,8,0" Padding="0">
                <Grid>
                    <Canvas x:Name="MapCanvas" ClipToBounds="True" Background="#0A0E18"
                            MouseLeftButtonDown="OnMapClick" />
                    <Border x:Name="AlertBanner" Visibility="Collapsed" VerticalAlignment="Top"
                            Background="#5A2330" BorderBrush="#D94F4F" BorderThickness="1" CornerRadius="4"
                            Margin="10" Padding="10,6">
                        <TextBlock x:Name="AlertText" Foreground="#FFD9D9" TextWrapping="Wrap" />
                    </Border>
                    <TextBlock x:Name="LegendText" Foreground="{StaticResource Muted}" FontSize="11"
                               VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="10"
                               Text="● green / amber / red = route danger    ◉ = your ship    ▲ idle producer (price softening)" />
                </Grid>
            </Border>

            <!-- right panel -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- board -->
                <Border Grid.Row="0" Style="{StaticResource PanelBox}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Header}"
                                   Text="CONTRACT BOARD — visible to you" />
                        <Button DockPanel.Dock="Bottom" x:Name="NegotiateBtn" Content="Negotiate selected ▸"
                                Click="OnNegotiate" Margin="0,6,0,0" HorizontalAlignment="Stretch" />
                        <ListBox x:Name="BoardList">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="9" Height="9" Fill="{Binding Danger}"
                                                 VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Margin="4,0">
                                            <TextBlock Text="{Binding Good}" Foreground="#E6EDF6" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Route}" Foreground="#8A97AD" FontSize="11" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Fee}" Foreground="#5EC8F2" FontWeight="SemiBold"
                                                       HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding Deadline}" Foreground="#8A97AD" FontSize="11"
                                                       HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- my hauls -->
                <Border Grid.Row="1" Style="{StaticResource PanelBox}" Margin="0,8,0,0" Height="186">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Header}" Text="MY HAULS — in flight" />
                        <ListBox x:Name="HaulsList">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,3">
                                        <TextBlock>
                                            <Run Text="{Binding Cargo}" Foreground="#E6EDF6" FontWeight="SemiBold" />
                                            <Run Text="{Binding Route}" Foreground="#8A97AD" />
                                        </TextBlock>
                                        <ProgressBar Value="{Binding Progress}" Maximum="1" Height="6" Margin="0,3"
                                                     Background="#1B2438" Foreground="#5EC8F2" BorderThickness="0" />
                                        <TextBlock Text="{Binding Detail}" Foreground="#8A97AD" FontSize="11" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- detail -->
                <Border Grid.Row="2" Style="{StaticResource PanelBox}" Margin="0,8,0,0" Height="150">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Header}" Text="DETAIL — click the map" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="DetailText" Foreground="{StaticResource Ink}" FontSize="12"
                                       TextWrapping="Wrap" FontFamily="Consolas"
                                       Text="Click a location or ship on the map." />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- bottom: event log -->
        <Border Grid.Row="2" Style="{StaticResource PanelBox}" Margin="0,8,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Header}" Text="EVENT LOG — the sector, live" />
                <ListBox x:Name="LogList" FontFamily="Consolas" FontSize="12">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text}" Foreground="{Binding Color}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</Window>
