@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject IJSRuntime JS

@if (_benchTicks is { } benchTicks)
{
    <BenchPanel Seed="_seed" Ticks="benchTicks" />
}
else if (_session is not null)
{
    <div class="screen" data-ready="@(_ready ? "true" : null)" data-tick="@_session.Now">
        <TimeBar Model="_header" Theme="@_theme" OnSpeed="SetSpeed" OnTheme="SetTheme" />

        @foreach (DecisionPrompt prompt in _decisions)
        {
            <DecisionPanel Model="prompt" OnDecide="choice => Decide(prompt, choice)" OnSelect="Select" />
        }

        @if (_header.Alerts.Count > 0)
        {
            <section class="alert panel" role="alert">
                <div class="alert-text">
                    <span class="alert-title">@_header.AlertTitle</span>
                    @foreach (string alert in _header.Alerts)
                    {
                        <span>@alert</span>
                    }
                </div>
                <button type="button" class="button primary" @onclick="() => SetSpeed(ClockSpeed.X1)">@_header.ResumeLabel</button>
            </section>
        }

        <div class="columns">
            <div class="column-main">
                <SectorMap Model="_map" Ships="_ships" Fleet="@_header.Fleet" />
                <div class="lower-row">
                    <NewsPanel Model="_news" OnSelect="Select" />
                    <CaptainsLog Model="_log" OnSelect="Select" />
                </div>
            </div>
            <div class="column-side">
                <BoardPanel Model="_board" Selected="_selected" OnSelect="Select" />
                <PostsPanel Model="_posts" OnSelect="Select" OnNewPost="NewPost" />
                @if (_composer is not null && _draft is not null)
                {
                    <ComposerPanel Model="_composer" Draft="_draft" Outcome="@_composerOutcome" OnChange="ChangeDraft" OnPost="Post" OnClose="CloseComposer" />
                }
                <ContractPanel Model="_contract" Outcome="@_outcome" NoneText="@Templates.Get("Contract.None")" OnAccept="Accept" OnCommand="Command" OnSelect="Select"
                               OnAcceptOffer="AcceptOffer" OnDecline="Decline" OnCounter="args => Counter(args.Thread, args.Offer)" OnAdvertise="Advertise" />
                <LedgerPanel Model="_ledger" OnSelect="Select" OnAction="Act" />
            </div>
        </div>
    </div>
}

@code {
    // The clock's frame: about 30 a second. Each frame advances the session by the real time since the last.
    private static readonly TimeSpan FrameInterval = TimeSpan.FromMilliseconds(33);

    private readonly CancellationTokenSource _stop = new();
    private GameSession? _session;
    private long _seed = 20260619;
    private long? _benchTicks;
    private bool _ready;
    private string _theme = "system";
    private IJSObjectReference? _module;

    private ContractId? _selected;
    private string? _outcome;

    // View models, rebuilt only when the session's revision or the selection changes.
    private long _builtRevision = -1;
    private ContractId? _builtSelection;
    private HeaderViewModel _header = default!;
    private BoardViewModel _board = default!;
    private MapViewModel _map = default!;
    private LogViewModel _log = default!;
    private NewsViewModel _news = default!;
    private LedgerViewModel _ledger = default!;
    private PostsViewModel _posts = default!;

    // The post composer, while it is open: the player's draft and the view built from it.
    private ComposerDraft? _draft;
    private ComposerViewModel? _composer;
    private string? _composerOutcome;
    private ContractViewModel? _contract;
    private IReadOnlyList<DecisionPrompt> _decisions = Array.Empty<DecisionPrompt>();
    private IReadOnlyList<MapShip> _ships = Array.Empty<MapShip>();

    protected override void OnInitialized()
    {
        Dictionary<string, string> query = Query(Navigation.ToAbsoluteUri(Navigation.Uri).Query);
        if (query.TryGetValue("seed", out string? seed) && long.TryParse(seed, System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out long s))
        {
            _seed = s;
        }

        if (query.TryGetValue("bench", out string? bench) && long.TryParse(bench, System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out long b) && b > 0)
        {
            _benchTicks = b;
            return;
        }

        // The world has run for a day and a few hours before the player looks at it, so the board has posts.
        _session = new GameSession(_seed, startTick: ByGalacticAccord.Engine.Simulation.GameTime.At(1, 6));
        Rebuild();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _session is null)
        {
            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/client.js");
        _theme = await _module.InvokeAsync<string>("storedTheme");
        _ready = true;
        StateHasChanged();
        _ = RunClock();
    }

    private async Task RunClock()
    {
        var watch = System.Diagnostics.Stopwatch.StartNew();
        double last = 0;
        using var timer = new PeriodicTimer(FrameInterval);
        try
        {
            while (await timer.WaitForNextTickAsync(_stop.Token))
            {
                double now = watch.Elapsed.TotalSeconds;
                double frame = now - last;
                last = now;
                if (_session is null || _session.Speed == ClockSpeed.Paused)
                {
                    continue;
                }

                _session.Advance(frame);
                Rebuild();
                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {
            // The page is going away.
        }
    }

    private void Rebuild()
    {
        if (_session is null)
        {
            return;
        }

        if (_builtRevision != _session.Revision || _builtSelection != _selected)
        {
            _header = HeaderView.Build(_session);
            _board = BoardView.Build(_session);
            _map = MapView.Build(_session, _selected);
            _log = LogView.Build(_session);
            _news = NewsView.Build(_session);
            _ledger = LedgerView.Build(_session);
            _posts = PostsView.Build(_session);
            _composer = _draft is { } draft ? ComposerView.Build(_session, draft) : null;
            _decisions = DecisionView.Build(_session);
            _contract = _selected is { } id ? ContractView.Build(_session, id) : null;
            _builtRevision = _session.Revision;
            _builtSelection = _selected;
        }

        _ships = MapView.Ships(_session, _session.Clock);
    }

    // Once the clock runs, the last command's outcome is history: the panels say where things stand now.
    private void SetSpeed(ClockSpeed speed)
    {
        _session?.SetSpeed(speed);
        if (speed != ClockSpeed.Paused)
        {
            _outcome = null;
        }

        Rebuild();
    }

    private async Task SetTheme(string theme)
    {
        _theme = theme;
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("setTheme", theme);
        }
    }

    // Selecting a contract shows it afresh, even the one already open: the last command's outcome gives way to what can be done now.
    private void Select(ContractId id)
    {
        _outcome = null;
        _selected = id;
        Rebuild();
    }

    private void Accept()
    {
        if (_session is null || _selected is not { } id)
        {
            return;
        }

        var contract = _session.Context.Contract(id);
        DealOutcome outcome = _session.Accept(id);
        _outcome = ContractView.OutcomeText(_session, contract, outcome);
        Rebuild();
    }

    private void Command(ContractCommand command)
    {
        if (_session is null || _selected is not { } id)
        {
            return;
        }

        var contract = _session.Context.Contract(id);
        _outcome = command switch
        {
            ContractCommand.Broker when contract is SaleContract wanted => ContractView.BrokerText(_session, wanted, _session.Broker(id)),
            ContractCommand.CancelAtWill => ContractView.CommandText(_session, contract, command, _session.CancelAtWill(id)),
            ContractCommand.CancelForDefault => ContractView.CommandText(_session, contract, command, _session.CancelForDefault(id)),
            ContractCommand.HaulAgain => ContractView.CommandText(_session, contract, command, _session.HaulAgain(id)),
            ContractCommand.Withdraw => ContractView.CommandText(_session, contract, command, _session.Withdraw(id)),
            _ => null,
        };
        Rebuild();
    }

    // Pay to show the player's own post in further systems (design §7.1, D38).
    private void Advertise(IReadOnlyCollection<LocationId> at)
    {
        if (_session is null || _selected is not { } id)
        {
            return;
        }

        var contract = _session.Context.Contract(id);
        (AdBlock block, Credits fee) = _session.Advertise(id, at);
        _outcome = AdView.OutcomeText(_session, contract, at, block, fee);
        Rebuild();
    }

    // ---- posting and haggling (design §3.6) ----

    private void NewPost()
    {
        if (_session is null)
        {
            return;
        }

        _draft = ComposerView.Default(_session, PostKind.Wanted);
        _composerOutcome = null;
        _builtRevision = -1;
        Rebuild();
    }

    // A new kind starts from that kind's first draft; any other change keeps the rest of what the player typed.
    private void ChangeDraft(ComposerDraft draft)
    {
        if (_session is null)
        {
            return;
        }

        _draft = _draft is { } before && before.Kind != draft.Kind ? ComposerView.Default(_session, draft.Kind) : draft;
        _composerOutcome = null;
        _builtRevision = -1;
        Rebuild();
    }

    private void Post()
    {
        if (_session is null || _draft is not { } draft)
        {
            return;
        }

        PostDraft post = ComposerView.ToPost(_session, draft);
        PostOutcome outcome = _session.Post(post);
        if (outcome.Post is { } posted)
        {
            _draft = null;
            _selected = posted.Id;
            _outcome = ComposerView.OutcomeText(_session, outcome, post);
        }
        else
        {
            _composerOutcome = ComposerView.OutcomeText(_session, outcome, post);
        }

        Rebuild();
    }

    private void CloseComposer()
    {
        _draft = null;
        _composerOutcome = null;
        _builtRevision = -1;
        Rebuild();
    }

    private void Counter(NegotiationId? thread, Offer offer)
    {
        if (_session is null || _selected is not { } id)
        {
            return;
        }

        DealBlock block = _session.Counter(id, offer, thread);
        _outcome = NegotiationView.CounterText(
            _session, _session.Context.Contract(id), block, thread is { } t ? _session.Context.Negotiation(t) : _session.Context.NegotiationWith(id, _session.Player.Id));
        Rebuild();
    }

    private void AcceptOffer(NegotiationId id)
    {
        if (_session is null)
        {
            return;
        }

        Negotiation thread = _session.Context.Negotiation(id);
        _outcome = NegotiationView.AcceptText(_session, thread, _session.AcceptOffer(id));
        Rebuild();
    }

    private void Decline(NegotiationId id)
    {
        if (_session is null)
        {
            return;
        }

        _outcome = NegotiationView.DeclineText(_session, _session.Context.Negotiation(id), _session.Decline(id));
        Rebuild();
    }

    private void Decide(DecisionPrompt prompt, DecisionChoice choice)
    {
        if (_session is null)
        {
            return;
        }

        _session.Decide(prompt.Decision, choice);
        _outcome = null;
        _selected = prompt.Contract;
        Rebuild();
    }

    private void Act(LedgerAction action)
    {
        if (_session is null)
        {
            return;
        }

        _ = action.Store ? _session.Store(action.Good) : _session.Retrieve(action.Good);
        Rebuild();
    }

    private static Dictionary<string, string> Query(string query)
    {
        var values = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (string pair in query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            int eq = pair.IndexOf('=', StringComparison.Ordinal);
            if (eq > 0)
            {
                values[Uri.UnescapeDataString(pair[..eq])] = Uri.UnescapeDataString(pair[(eq + 1)..]);
            }
        }

        return values;
    }

    public async ValueTask DisposeAsync()
    {
        await _stop.CancelAsync();
        _stop.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Nothing to release once the page is gone.
            }
        }
    }
}
