<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- The browser client (design §18): it runs the simulation in WebAssembly and renders the interface of
       §11 from the presentation library's view models. -->
  <PropertyGroup>
    <AssemblyName>ByGalacticAccord.Client</AssemblyName>
    <RootNamespace>ByGalacticAccord.Client</RootNamespace>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- Every number is formatted with the invariant culture, so the browser needs no ICU data. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <BlazorEnableTimeZoneSupport>false</BlazorEnableTimeZoneSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ByGalacticAccord.Presentation\ByGalacticAccord.Presentation.csproj" />
  </ItemGroup>

</Project>
