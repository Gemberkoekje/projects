@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@inject IJSRuntime JS

<div @ref="_terminalOutput"
     class="terminal-output bg-dark text-light p-3 rounded font-monospace"
     style="min-height: 400px; max-height: 600px; overflow-y: auto;">
    @foreach (var (role, text) in Lines)
    {
        @if (role == "player")
        {
            <p class="text-warning mb-1">@text</p>
        }
        else
        {
            <p class="text-light mb-2">@text</p>
        }
    }
    @if (!string.IsNullOrEmpty(StreamingText))
    {
        <p class="text-light mb-2">@StreamingText<span class="blinking-cursor">▌</span></p>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<(string Role, string Text)> Lines { get; set; } = Array.Empty<(string, string)>();
    [Parameter] public string StreamingText { get; set; } = string.Empty;

    private ElementReference _terminalOutput;
    private int _lastLineCount = -1;
    private string _lastStreamingText = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var contentChanged = firstRender
            || _lastLineCount != Lines.Count
            || !string.Equals(_lastStreamingText, StreamingText, StringComparison.Ordinal);

        if (!contentChanged)
            return;

        _lastLineCount = Lines.Count;
        _lastStreamingText = StreamingText;

        try
        {
            await JS.InvokeVoidAsync("adventureTerminal.scrollToBottom", _terminalOutput);
        }
        catch (JSDisconnectedException)
        {
            // Ignore disconnects during navigation/reconnect windows.
        }
    }
}
