@page "/play/{SessionId:guid}"
@rendermode InteractiveServer
@inject IGameSessionService SessionService
@implements IDisposable

<PageTitle>@(_world?.Title ?? "Adventure")</PageTitle>

<div class="container-fluid py-3" style="max-width: 900px;">
    @if (_gameSession is null)
    {
        <div class="d-flex justify-content-center py-5">
            <div class="spinner-border text-light" role="status">
                <span class="visually-hidden">Loading…</span>
            </div>
        </div>
    }
    else
    {
        <div class="mb-3">
            <h4 class="text-light">@_world?.Title</h4>
            <small class="text-muted">Chapter @_gameSession.CurrentChapterIndex</small>
        </div>

        <GameTerminal Lines="_terminalLines" StreamingText="_streamBuffer" />

        <div class="mt-3">
            <div class="input-group">
                <input class="form-control bg-dark text-light border-secondary"
                       placeholder="What do you do?"
                       @bind="_playerInput"
                       @bind:event="oninput"
                       @onkeydown="HandleKeyDownAsync"
                       disabled="@_isStreaming" />
                <button class="btn btn-outline-light" @onclick="SubmitActionAsync" disabled="@(_isStreaming || string.IsNullOrWhiteSpace(_playerInput))">
                    @if (_isStreaming)
                    {
                        <span class="spinner-border spinner-border-sm" />
                    }
                    else
                    {
                        <span>↵</span>
                    }
                </button>
            </div>
            @if (_errorMessage is not null)
            {
                <div class="alert alert-danger mt-2">@_errorMessage</div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public Guid SessionId { get; set; }

    private GameSession? _gameSession;
    private WorldManifest? _world;
    private readonly List<(string Role, string Text)> _terminalLines = new();
    private string _streamBuffer = string.Empty;
    private string _playerInput = string.Empty;
    private bool _isStreaming;
    private string? _errorMessage;
    private CancellationTokenSource? _cts;

    protected override async Task OnInitializedAsync()
    {
        _gameSession = await SessionService.GetSessionAsync(SessionId);
        _world = _gameSession?.WorldManifest;

        if (_gameSession is not null && _world is not null)
        {
            var chapter = _world.Chapters.FirstOrDefault(c => c.Index == _gameSession.CurrentChapterIndex);
            var scene = chapter?.Scenes.FirstOrDefault(s => s.Id == _gameSession.CurrentSceneId);

            if (scene is not null)
                _terminalLines.Add(("narrator", scene.Description));

            foreach (var (input, response) in _gameSession.RecentHistory)
            {
                _terminalLines.Add(("player", $"> {input}"));
                _terminalLines.Add(("narrator", response));
            }
        }
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_isStreaming && !string.IsNullOrWhiteSpace(_playerInput))
            await SubmitActionAsync();
    }

    private async Task SubmitActionAsync()
    {
        if (string.IsNullOrWhiteSpace(_playerInput) || _isStreaming)
            return;

        var input = _playerInput.Trim();
        _playerInput = string.Empty;
        _isStreaming = true;
        _streamBuffer = string.Empty;
        _errorMessage = null;
        _terminalLines.Add(("player", $"> {input}"));

        _cts = new CancellationTokenSource();

        try
        {
            var response = await SessionService.SubmitActionAsync(SessionId, input, _cts.Token);
            _streamBuffer = string.Empty;
            _terminalLines.Add(("narrator", response));
            _gameSession = await SessionService.GetSessionAsync(SessionId);
        }
        catch (OperationCanceledException)
        {
            // User cancelled
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            _isStreaming = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
