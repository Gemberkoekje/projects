@page "/play/{SessionId:guid}"
@rendermode InteractiveServer
@inject IGameSessionService SessionService
@implements IDisposable

<PageTitle>@(_world?.Title ?? "Adventure")</PageTitle>

<div class="container-fluid py-3" style="max-width: 900px;">
    @if (_gameSession is null)
    {
        <div class="d-flex justify-content-center py-5">
            <div class="spinner-border text-light" role="status">
                <span class="visually-hidden">Loading…</span>
            </div>
        </div>
    }
    else
    {
        <div class="mb-3 d-flex justify-content-between align-items-center">
            <div>
                <h4 class="text-light mb-0">@_world?.Title</h4>
                <small class="text-muted">Chapter @_gameSession.CurrentChapterIndex</small>
            </div>
            <a href="/" class="btn btn-sm btn-outline-secondary">← Home</a>
        </div>

        @if (_chapterTransitionMessage is not null)
        {
            <div class="alert alert-info alert-dismissible mb-3" role="alert">
                @_chapterTransitionMessage
                <button type="button" class="btn-close" @onclick="() => _chapterTransitionMessage = null" />
            </div>
        }

        <GameTerminal Lines="_terminalLines" StreamingText="_streamBuffer" />

        @if (_gameSession.Status == SessionStatus.Completed)
        {
            <div class="alert alert-success mt-3 text-center fw-bold fs-5">
                🏆 Victory! Your adventure is complete.
            </div>
            <div class="text-center mt-2">
                <a href="/" class="btn btn-primary">Start a new adventure</a>
            </div>
        }
        else if (_gameSession.Status == SessionStatus.Abandoned)
        {
            <div class="alert alert-secondary mt-3 text-center fw-bold fs-5">
                💀 Your adventure has ended.
            </div>
            <div class="text-center mt-2">
                <a href="/" class="btn btn-primary">Try again</a>
            </div>
        }
        else
        {
            <div class="mt-3">
                <div class="input-group">
                    <input class="form-control bg-dark text-light border-secondary"
                           placeholder="What do you do?"
                           @bind="_playerInput"
                           @bind:event="oninput"
                           @onkeydown="HandleKeyDownAsync"
                           disabled="@_isStreaming" />
                    <button class="btn btn-outline-light" @onclick="SubmitActionAsync" disabled="@(_isStreaming || string.IsNullOrWhiteSpace(_playerInput))">
                        @if (_isStreaming)
                        {
                            <span class="spinner-border spinner-border-sm" />
                        }
                        else
                        {
                            <span>↵</span>
                        }
                    </button>
                </div>
                @if (_errorMessage is not null)
                {
                    <div class="alert alert-danger mt-2">@_errorMessage</div>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter] public Guid SessionId { get; set; }

    private GameSession? _gameSession;
    private WorldManifest? _world;
    private readonly List<(string Role, string Text)> _terminalLines = new();
    private string _streamBuffer = string.Empty;
    private string _playerInput = string.Empty;
    private bool _isStreaming;
    private string? _errorMessage;
    private string? _chapterTransitionMessage;
    private CancellationTokenSource? _cts;

    protected override async Task OnInitializedAsync()
    {
        _gameSession = await SessionService.GetSessionAsync(SessionId);
        _world = _gameSession?.WorldManifest;

        if (_gameSession is not null && _world is not null)
        {
            var chapter = _world.Chapters.FirstOrDefault(c => c.Index == _gameSession.CurrentChapterIndex);
            var scene = chapter?.Scenes.FirstOrDefault(s => s.Id == _gameSession.CurrentSceneId);

            if (scene is not null)
                _terminalLines.Add(("narrator", scene.Description));

            foreach (var (input, response) in _gameSession.RecentHistory)
            {
                _terminalLines.Add(("player", $"> {input}"));
                _terminalLines.Add(("narrator", response));
            }
        }
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_isStreaming && !string.IsNullOrWhiteSpace(_playerInput))
            await SubmitActionAsync();
    }

    private async Task SubmitActionAsync()
    {
        if (string.IsNullOrWhiteSpace(_playerInput) || _isStreaming)
            return;

        var input = _playerInput.Trim();
        _playerInput = string.Empty;
        _isStreaming = true;
        _streamBuffer = string.Empty;
        _errorMessage = null;
        _chapterTransitionMessage = null;
        _terminalLines.Add(("player", $"> {input}"));

        _cts = new CancellationTokenSource();

        var previousChapter = _gameSession?.CurrentChapterIndex ?? 1;

        try
        {
            var response = await SessionService.SubmitActionAsync(SessionId, input, _cts.Token);
            _streamBuffer = string.Empty;
            _terminalLines.Add(("narrator", response));
            _gameSession = await SessionService.GetSessionAsync(SessionId);

            if (_gameSession is not null && _gameSession.CurrentChapterIndex != previousChapter)
            {
                _chapterTransitionMessage =
                    $"📖 Chapter {previousChapter} complete! Now entering Chapter {_gameSession.CurrentChapterIndex}: " +
                    $"{_world?.Chapters.FirstOrDefault(c => c.Index == _gameSession.CurrentChapterIndex)?.Title ?? string.Empty}";

                var newScene = _world?.Chapters
                    .FirstOrDefault(c => c.Index == _gameSession.CurrentChapterIndex)
                    ?.Scenes.FirstOrDefault(s => s.Id == _gameSession.CurrentSceneId);

                if (newScene is not null)
                    _terminalLines.Add(("narrator", newScene.Description));
            }
        }
        catch (OperationCanceledException)
        {
            // User cancelled
        }
        catch (Exception ex)
        {
            if (_terminalLines.Count > 0)
                _terminalLines.RemoveAt(_terminalLines.Count - 1);
            _playerInput = input;
            _errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            _isStreaming = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
