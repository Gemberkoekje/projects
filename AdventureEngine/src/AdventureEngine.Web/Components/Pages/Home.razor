@page "/"
@rendermode InteractiveServer
@inject IGameSessionService SessionService
@inject NavigationManager Nav

<PageTitle>LLM Adventure</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h1 class="mb-4">⚔️ LLM Adventure</h1>
            <p class="lead text-muted mb-5">Enter a premise and let the AI weave your adventure.</p>

            <div class="card shadow-sm mb-5">
                <div class="card-body p-4">
                    <h5 class="card-title mb-3">Begin a new adventure</h5>
                    <EditForm Model="_model" OnValidSubmit="StartAdventureAsync">
                        <DataAnnotationsValidator />
                        <div class="mb-3">
                            <label class="form-label">Your premise</label>
                            <InputTextArea class="form-control" rows="4"
                                           @bind-Value="_model.Prompt"
                                           placeholder="e.g. A cyberpunk detective investigating a corporate cover-up in neon-soaked Neo Tokyo..." />
                            <ValidationMessage For="@(() => _model.Prompt)" />
                        </div>
                        <button type="submit" class="btn btn-primary" disabled="@_isCreating">
                            @if (_isCreating)
                            {
                                <span class="spinner-border spinner-border-sm me-2" />
                                <span>Generating world…</span>
                            }
                            else
                            {
                                <span>Start Adventure</span>
                            }
                        </button>
                    </EditForm>
                    @if (_errorMessage is not null)
                    {
                        <div class="alert alert-danger mt-3">@_errorMessage</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private sealed class NewAdventureModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Please enter a premise.")]
        [System.ComponentModel.DataAnnotations.MinLength(10, ErrorMessage = "Premise must be at least 10 characters.")]
        public string Prompt { get; set; } = string.Empty;
    }

    private readonly NewAdventureModel _model = new();
    private bool _isCreating;
    private string? _errorMessage;

    private async Task StartAdventureAsync()
    {
        _isCreating = true;
        _errorMessage = null;

        try
        {
            // Use a placeholder player ID until authentication is added.
            const string guestPlayerId = "guest";
            var sessionId = await SessionService.CreateSessionAsync(guestPlayerId, _model.Prompt);
            Nav.NavigateTo($"/play/{sessionId}");
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to start adventure: {ex.Message}";
        }
        finally
        {
            _isCreating = false;
        }
    }
}
