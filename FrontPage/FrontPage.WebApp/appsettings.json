{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cluster": {
    "RefreshSeconds": 30,
    "SystemNamespaces": [
      "cert-manager",
      "cluster-healthcheck",
      "default",
      "dockhand",
      "flux-system",
      "kube-node-lease",
      "kube-public",
      "kube-system",
      "lan-proxy",
      "metallb-system",
      "monitoring",
      "reflector",
      "system-upgrade",
      "tailscale",
      "traefik"
    ]
  },
  "Apps": {
    "plotboek": [ "plotboek-generator/plotboek-generator" ],
    "charactercreator": [ "charactercreator/charactercreator" ],
    "curatool": [ "curatool/curatool" ],
    "bot-on-the-clocktower": [ "bot-on-the-clocktower/bot-on-the-clocktower" ],
    "armabot": [ "armabotcs/armabotcs" ],
    "bygalacticaccord": [ "bygalacticaccord/bygalacticaccord" ],
    "hackerminigames": [ "hackerminigames/hackerminigames" ],
    "adventureengine": [ "adventureengine/adventureengine" ],
    "datumprikker": [ "datumprikker/datumprikker" ],
    "dungeontable": [ "dungeontable/dungeontable" ],
    "kluskat": [ "kluskat/kluskat" ],
    "ebi": [ "ebi-cs-api/ebi-cs-api", "ebi-cs-api/ebi-cs-frontend" ]
  }
}
