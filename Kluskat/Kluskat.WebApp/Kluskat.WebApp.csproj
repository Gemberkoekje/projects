<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Kluskat.WebApp</RootNamespace>
    <Nullable>enable</Nullable>
    <OutputType>exe</OutputType>
    <IsPublishable>true</IsPublishable>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <SelfContained>false</SelfContained>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <UserSecretsId>aspnet-Kluskat.WebApp-6c1f6f0e-6f3b-4b4e-9d4b-1c2a7e5b9a31</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kluskat.test" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Qowaiv.Diagnostics.Contracts" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Kluskat.infrastructure/Kluskat.infrastructure.csproj" />
  </ItemGroup>

</Project>
