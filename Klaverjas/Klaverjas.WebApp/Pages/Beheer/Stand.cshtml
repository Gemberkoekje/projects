@page
@model StandModel
@{
    ViewData["Title"] = "Stand";
    ViewData["Tab"] = "stand";
    var o = Model.Overzicht;
    var m = Model.Mail;
    var stand = o.Weergave;
    var adres = HttpContext.Request.Host.Value;
    var knop = "Staat online ✓";
    if (o.Online.IsLeeg)
    {
        knop = "Zet de stand online";
    }
    else if (o.IsGewijzigd)
    {
        knop = "Verbeterde stand online zetten";
    }
}

@if (stand.IsLeeg)
{
    <h1>Stand</h1>
    <div class="card">
        <p>Er is nog geen avond ingevuld. Begin bij <a asp-page="/Beheer/Index">Avonden</a> met <b>Uitslag invullen</b>.</p>
    </div>
    return;
}

@if (Model.NetOnline)
{
    <div class="banner ok big"><p>✓ De stand staat online. De spelers zien hem nu op @adres.</p></div>
}
else if (o.IsGewijzigd)
{
    <div class="banner warn"><p><b>U heeft iets gewijzigd nadat de stand online is gezet.</b><br>Zet de verbeterde stand online, dan zien de spelers de goede cijfers.</p></div>
}
else if (Model.Opgeslagen != default)
{
    <div class="banner ok"><p><b>De uitslag van @Weergave.InZin(Model.Opgeslagen) is opgeslagen.</b> Kijk of de stand klopt en zet hem dan online.</p></div>
}
else if (o.StaatOnline)
{
    <div class="banner ok"><p>Deze stand staat online sinds @Weergave.Moment(o.Online.OnlineSinds).</p></div>
}

<h1>Stand na week @Kalender.Week(stand.LaatsteAvond)</h1>
<p class="lead">@Weergave.Lang(stand.LaatsteAvond)</p>

<div class="card">
    <div class="actions" style="justify-content:space-between; margin-bottom:1rem">
        <h2 style="margin:0">Zo zien de spelers de stand</h2>
        <span>Klopt er iets niet? <a class="btn secondary small" asp-page="/Beheer/Uitslag" asp-route-datum="@Weergave.Iso(stand.LaatsteAvond)">Uitslag wijzigen</a></span>
    </div>

    <ul class="winners">
        <li class="muted">Winnaars van de avond:</li>
        @foreach (var winnaar in stand.Winnaars)
        {
            <li><span class="medal @Weergave.PlaatsKlasse(winnaar.Plaats)">@winnaar.Plaats</span> @winnaar.Naam@(winnaar.IsInvaller ? " (invaller)" : string.Empty) <b>@Weergave.Getal(winnaar.Punten)</b></li>
        }
    </ul>

    <partial name="_StandTabellen" model="stand" />
</div>

<div class="card" id="online">
    <h2>Online zetten</h2>
    <p>Met één klik staat de stand op <b>@adres</b>. De spelers kijken daar met het wachtwoord van de club.</p>
    @if (!o.Instellingen.SpelerspaginaOpen)
    {
        <div class="banner warn"><p>Er is nog geen wachtwoord voor de spelers, dus zij kunnen nog niet kijken. Kies er een bij <a asp-page="/Beheer/Instellingen" asp-fragment="spelerspagina">Instellingen</a>.</p></div>
    }
    @if (!string.IsNullOrEmpty(Model.Fout))
    {
        <div class="banner warn" role="alert"><p>@Model.Fout</p></div>
    }
    <form method="post" asp-page="/Beheer/Stand" asp-page-handler="Online" id="online-form">
        <div class="field">
            <label for="bericht">Bericht erbij <span class="muted" style="font-weight:400">(mag leeg blijven)</span></label>
            <p class="help">Dit komt boven de stand: op de spelerspagina, en in de e-mail als u die ook stuurt.</p>
            <textarea id="bericht" class="text" name="Bericht" maxlength="@OnlineStand.MaxBericht" placeholder="Bijvoorbeeld: volgende week beginnen we een half uur later.">@Model.Bericht</textarea>
        </div>
        <div class="actions">
            <button type="submit" class="btn big" id="online-knop" disabled="@o.StaatOnline" data-opnieuw="Opnieuw online zetten, met dit bericht">@knop</button>
            <a class="btn secondary" href="~/" target="_blank" rel="noopener">Bekijk de spelerspagina</a>
        </div>
    </form>
</div>

<div class="card" id="mail">
    <h2>Ook e-mailen</h2>
    <p>Wie wil, krijgt de stand ook per e-mail, met de PDF erbij. Het hoeft niet: de stand staat al online.</p>
    @if (!string.IsNullOrEmpty(Model.MailUitslag))
    {
        <div class="banner @(Model.MailMislukt ? "warn" : "ok big")" role="status"><p>@Model.MailUitslag</p></div>
    }
    @if (!string.IsNullOrEmpty(Model.MailFout))
    {
        <div class="banner warn" role="alert"><p>@Model.MailFout</p></div>
    }
    @if (!m.IsIngesteld)
    {
        <p class="help status-warn">Mailen staat nog niet aan op de server. De beheerder van de site zet het aan.</p>
    }
    else if (o.Online.IsLeeg)
    {
        <p class="help">Zet de stand eerst online; daarna kunt u hem ook mailen.</p>
    }
    else if (o.IsGewijzigd)
    {
        <p class="help status-warn">Zet eerst de verbeterde stand online; die gaat dan ook in de e-mail.</p>
    }
    else
    {
        <p>De e-mail gaat naar <b>@m.Ontvangers @(m.Ontvangers == 1 ? "lid" : "leden")</b> (ieder een eigen e-mail), met de stand van week @Kalender.Week(o.Online.Stand.LaatsteAvond).
            @if (m.ZonderEmail.Count > 0)
            {
                <text>@(m.ZonderEmail.Count == 1 ? "Deze speler heeft" : "Deze spelers hebben") geen e-mailadres: <b>@string.Join(", ", m.ZonderEmail)</b>. Print de PDF voor @(m.ZonderEmail.Count == 1 ? "die speler" : "hen").</text>
            }
        </p>
        @if (!Emailadres.IsGeldig(m.Antwoordadres))
        {
            <div class="banner warn"><p>Vul eerst bij <a asp-page="/Beheer/Instellingen" asp-fragment="email">Instellingen</a> uw eigen e-mailadres in, bij "Antwoorden gaan naar". Daar komen de antwoorden van de spelers, en de proefmail.</p></div>
        }
        @if (m.IsGemaild)
        {
            <p class="status-ok">✓ Gemaild op @Weergave.Moment(m.LaatsteVerzending.Verstuurd) aan @m.LaatsteVerzending.Gelukt @(m.LaatsteVerzending.Gelukt == 1 ? "lid" : "leden").@(m.AlGemaild ? string.Empty : " Daarna is de stand verbeterd.")</p>
        }
        @if (m.IsProefGestuurd)
        {
            <p class="muted">Proefmail gestuurd op @Weergave.Moment(m.LaatsteProef.Verstuurd) naar @m.LaatsteProef.Ontvangers.Select(x => x.Email).FirstOrDefault().</p>
        }

        @if (Model.Bevestigen && m.Ontvangers > 0)
        {
            <div class="bevestig">
                <p><b>Stand van week @Kalender.Week(o.Online.Stand.LaatsteAvond) mailen naar @m.Ontvangers @(m.Ontvangers == 1 ? "lid" : "leden"), met de PDF erbij?</b><br>Onderwerp: "@m.Onderwerp"</p>
                @if (m.AlGemaild)
                {
                    <p class="status-warn">Let op: precies deze stand is al gemaild op @Weergave.Moment(m.LaatsteVerzending.Verstuurd). Dan krijgt iedereen hem twee keer.</p>
                }
                <form method="post" asp-page="/Beheer/Stand" asp-page-handler="Mailen" class="actions bezig" data-bezig="Bezig met versturen…">
                    <button type="submit" class="btn big">@(m.AlGemaild ? "Toch nog een keer versturen" : "Ja, versturen")</button>
                    <a class="btn secondary" asp-page="/Beheer/Stand" asp-fragment="mail">Nee, nog niet</a>
                </form>
            </div>
        }
        else
        {
            <div class="actions">
                @if (m.Ontvangers > 0 && Emailadres.IsGeldig(m.Antwoordadres))
                {
                    <a class="btn" asp-page="/Beheer/Stand" asp-route-stap="mailen" asp-fragment="mail">@(m.IsGemaild && m.AlGemaild ? "Nog een keer e-mailen…" : "E-mailen…")</a>
                }
                @if (Emailadres.IsGeldig(m.Antwoordadres))
                {
                    <form method="post" asp-page="/Beheer/Stand" asp-page-handler="Proef" class="bezig" data-bezig="Bezig met versturen…">
                        <button type="submit" class="btn secondary">Proefmail naar mij</button>
                    </form>
                }
                <a class="btn secondary" asp-page="/Beheer/MailVoorbeeld">Zo ziet de e-mail eruit</a>
                <a class="btn secondary" asp-page="/Beheer/Stand" asp-page-handler="Pdf" target="_blank" rel="noopener">PDF bekijken</a>
            </div>
        }
    }
</div>

@section Scripts {
    <script src="~/js/stand.js" asp-append-version="true"></script>
}
