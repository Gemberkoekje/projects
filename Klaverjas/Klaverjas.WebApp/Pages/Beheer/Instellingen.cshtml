@page
@model InstellingenModel
@{
    ViewData["Title"] = "Instellingen";
    ViewData["Tab"] = "instellingen";
    var h = Model.Huidig;
    var dagen = new[] { DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday };
}

<h1>Instellingen</h1>
<p class="lead">Alles hieronder mag u veranderen. Vergeet niet op <b>Opslaan</b> te klikken.</p>

@if (!string.IsNullOrEmpty(Model.Bevestiging))
{
    <div class="banner ok"><p>@Model.Bevestiging</p></div>
}
@if (Model.Meldingen.Count > 0)
{
    <div class="banner warn" role="alert">
        <ul>
            @foreach (var melding in Model.Meldingen)
            {
                <li>@melding</li>
            }
        </ul>
    </div>
}

@* One settings form; its fields sit in several cards and point at it with form="instellingen". *@
<form method="post" asp-page="/Beheer/Instellingen" id="instellingen"></form>

<div class="card">
    <h2>Club</h2>
    <div class="field">
        <label for="club">Naam van de club</label>
        <p class="help">Staat bovenaan de schermen.</p>
        <input id="club" class="text" name="Formulier.Club" value="@h.Club" form="instellingen" required>
    </div>
</div>

<div class="card">
    <h2>Spelregels</h2>
    <div class="field">
        <label for="afwezig">Punten bij afwezigheid</label>
        <p class="help">Wie een avond overslaat, krijgt dit aantal punten en geen pitten.</p>
        <input id="afwezig" class="text short" name="Formulier.PuntenAfwezig" value="@h.PuntenAfwezig" inputmode="numeric" form="instellingen" required>
    </div>
    <div class="field">
        <label for="speeldag">Speelavond</label>
        <select id="speeldag" name="Formulier.Speeldag" style="max-width:14rem" form="instellingen">
            @foreach (var dag in dagen)
            {
                <option value="@dag" selected="@(dag == h.Speeldag)">@Weergave.Dag(dag)</option>
            }
        </select>
    </div>
</div>

<div class="card">
    <h2>Seizoen @h.EersteAvond.Year</h2>
    <div class="field">
        <label for="eerste">Eerste speelavond</label>
        <p class="help">Een seizoen is een kalenderjaar: in januari begint de stand weer bij 0.</p>
        <input id="eerste" class="text" type="date" name="Formulier.EersteAvond" value="@Weergave.Iso(h.EersteAvond)" style="max-width:14rem" form="instellingen" required>
    </div>
    <div class="field">
        <span class="label">Geen klaverjassen op</span>
        <p class="help">Deze avonden slaat het programma over. In de stand staat dan de reden, zoals nu.</p>
        @if (h.GeenSpeelavonden.Count > 0)
        {
            <table class="list" style="max-width:40rem">
                <tbody>
                    @foreach (var vrij in h.GeenSpeelavonden)
                    {
                        <tr>
                            <td>@Weergave.Lang(vrij.Datum)</td>
                            <td>@vrij.Reden</td>
                            <td class="knop">
                                <form method="post" asp-page-handler="VrijWeghalen">
                                    <input type="hidden" name="datum" value="@Weergave.Iso(vrij.Datum)">
                                    <button type="submit" class="btn danger small">Weghalen</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        <form method="post" asp-page-handler="VrijToevoegen" class="inline" style="margin-top:.6rem">
            <input class="text" type="date" name="VrijDatum" style="max-width:14rem" aria-label="Datum zonder klaverjassen" required>
            <input class="text" name="VrijReden" placeholder="Reden, bijv. Kerst" style="max-width:14rem" aria-label="Reden">
            <button type="submit" class="btn secondary small">Toevoegen</button>
        </form>
    </div>
</div>

<div class="card" id="email">
    <h2>De e-mail</h2>
    <p class="help">Mailen is een extra: de stand staat al online. Wie wil, krijgt hem ook per e-mail, met de PDF erbij.</p>
    @if (!Model.MailIngesteld)
    {
        <p class="help status-warn">Mailen staat nog niet aan op de server. De beheerder van de site zet het aan.</p>
    }
    <div class="field">
        <label for="afzender">Naam van de afzender</label>
        <p class="help">Deze naam zien de spelers boven de e-mail.</p>
        <input id="afzender" class="text" name="Formulier.AfzenderNaam" value="@h.AfzenderNaam" form="instellingen">
    </div>
    <div class="field">
        <label for="antwoord">Antwoorden gaan naar</label>
        <p class="help">Uw eigen e-mailadres. Als een speler op de e-mail antwoordt, komt het antwoord hier; de proefmail gaat ook hierheen.</p>
        <input id="antwoord" class="text" type="email" name="Formulier.Antwoordadres" value="@h.Antwoordadres" autocomplete="email" form="instellingen">
    </div>
    <div class="field" style="margin-bottom:0">
        <label for="onderwerp">Onderwerp</label>
        <p class="help">Het weeknummer komt er vanzelf achter, bijvoorbeeld: <b>@h.Onderwerp @Kalender.Week(Kalender.Vandaag())</b></p>
        <input id="onderwerp" class="text" name="Formulier.Onderwerp" value="@h.Onderwerp" style="max-width:20rem" form="instellingen" required>
    </div>
</div>

<div class="card">
    <h2>Kleuren in de stand</h2>
    <div class="inline" style="gap:1.25rem 2rem">
        <label class="inline"><input type="color" name="Formulier.KleurEerste" value="@h.Kleuren.Eerste" form="instellingen"> 1e plaats</label>
        <label class="inline"><input type="color" name="Formulier.KleurTweede" value="@h.Kleuren.Tweede" form="instellingen"> 2e plaats</label>
        <label class="inline"><input type="color" name="Formulier.KleurDerde" value="@h.Kleuren.Derde" form="instellingen"> 3e plaats</label>
        <label class="inline"><input type="color" name="Formulier.KleurAfwezig" value="@h.Kleuren.Afwezig" form="instellingen"> Niet aanwezig</label>
    </div>
</div>

<div class="card" id="spelerspagina">
    <h2>Spelerspagina</h2>
    <p class="help">De spelers bekijken de stand op <b>@HttpContext.Request.Host.Value</b> (alleen kijken, niets wijzigen). De eerste keer vraagt de pagina dit wachtwoord; daarna onthoudt hun telefoon of computer het.
        Verandert u het wachtwoord, dan moet iedereen het nieuwe één keer intypen. Hoofdletters maken voor de spelers niet uit. Uw eigen wachtwoord (voor het beheer) staat hieronder en is een ander.</p>
    <div class="field">
        <label for="spelerswachtwoord">Wachtwoord voor de spelers</label>
        @if (!h.SpelerspaginaOpen)
        {
            <p class="help status-warn">Nog geen wachtwoord: de spelers kunnen de stand nog niet bekijken.</p>
        }
        <input id="spelerswachtwoord" class="text" name="Formulier.Spelerswachtwoord" value="@h.Spelerswachtwoord" style="max-width:16rem" autocomplete="off" autocapitalize="none" spellcheck="false" form="instellingen">
    </div>
    <div class="field" style="margin-bottom:0">
        <span class="label">Briefjes om uit te delen</span>
        <p class="help">Kleine briefjes met het adres en het wachtwoord, 10 per A4. Printen, knippen en uitdelen op de avond.</p>
        @if (h.SpelerspaginaOpen)
        {
            <a class="btn secondary" asp-page="/Beheer/Afdrukken/Briefjes">Briefjes printen</a>
        }
        else
        {
            <p class="help">Kies eerst een wachtwoord en klik op Opslaan.</p>
        }
    </div>
</div>

<div class="card">
    <h2>Uw wachtwoord</h2>
    <p class="help">Hiermee logt u in op het beheer. Wilt u een nieuw wachtwoord, typ het dan twee keer (minstens @Wachtwoord.MinimumLengteBeheer tekens). Laat de vakjes leeg om uw wachtwoord te houden.</p>
    <div class="inline">
        <input class="text" type="password" name="Formulier.NieuwWachtwoord" placeholder="Nieuw wachtwoord" style="max-width:16rem" aria-label="Nieuw wachtwoord" autocomplete="new-password" form="instellingen">
        <input class="text" type="password" name="Formulier.NieuwWachtwoordHerhaald" placeholder="Nog een keer" style="max-width:16rem" aria-label="Nieuw wachtwoord nog een keer" autocomplete="new-password" form="instellingen">
    </div>
</div>

<button type="submit" class="btn big" form="instellingen">Opslaan</button>

<div class="card" id="excel" style="margin-top:2rem">
    <h2>Excel</h2>
    @if (!string.IsNullOrEmpty(Model.ExcelFout))
    {
        <div class="banner warn" role="alert"><p>@Model.ExcelFout</p></div>
    }
    <div class="field">
        <span class="label">De standen uit Excel inlezen</span>
        <p class="help">Kies het bestand "Standen week …" dat u nu elke week bijhoudt. Er wordt nog niets opgeslagen: u ziet eerst wat er gebeurt, en of alles klopt.</p>
        <form method="post" enctype="multipart/form-data" asp-page="/Beheer/Inlezen" asp-page-handler="Lezen" class="inline">
            <input class="file" type="file" name="bestand" accept=".xlsx" aria-label="Het Excel-bestand met de standen" required>
            <button type="submit" class="btn">Bestand lezen</button>
        </form>
    </div>
    <hr class="sep">
    <div class="field" style="margin-bottom:0">
        <span class="label">Alle scores downloaden</span>
        <p class="help">Alle spelers en alle uitslagen in één Excel-bestand: de stand en de pitten zoals u gewend bent, plus elke uitslag op een rij. Bewaar het als reservekopie, of om zelf mee te rekenen.</p>
        <a class="btn secondary" asp-page="/Beheer/Inlezen" asp-page-handler="Downloaden">Downloaden (Excel)</a>
    </div>
</div>
