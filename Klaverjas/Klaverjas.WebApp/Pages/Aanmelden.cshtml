@page
@model AanmeldenModel
@{
    Layout = "_Spelers";
    ViewData["Title"] = "De stand bekijken";
}

<form method="post" class="p-login">
    <h1>De stand bekijken</h1>
    @if (!Model.Instellingen.SpelerspaginaOpen)
    {
        <p>De stand staat nog niet open voor de spelers. Probeer het na de volgende clubavond nog eens.</p>
    }
    else
    {
        <p>Typ het wachtwoord van de club. Dat staat op het briefje dat u op de clubavond kreeg.</p>
        <label for="wachtwoord">Wachtwoord</label>
        <input id="wachtwoord" class="text" type="password" asp-for="Wachtwoord" autocomplete="current-password" autocapitalize="none" autocorrect="off" spellcheck="false" autofocus required />
        @if (!string.IsNullOrEmpty(Model.Fout))
        {
            <p class="fout" role="alert">@Model.Fout</p>
        }
        <button type="submit" class="btn big">Bekijk de stand</button>
        <p class="muted klein">U blijft ingelogd op deze telefoon of computer.</p>
    }
</form>
