@page
@model IndexModel
@{
    Layout = "_Spelers";
    var online = Model.Online;
    var stand = online.Stand;
    var laatste = stand.LaatsteKolom;
    ViewData["Title"] = "Stand";
    ViewData["Jaar"] = online.IsLeeg ? string.Empty : Weergave.Getal(stand.Jaar);

    void PuntenCel(WeergaveCel cel)
    {
        if (cel.IsLeeg)
        {
            <td></td>
        }
        else if (cel.IsAfwezig)
        {
            <td class="r ca">@Weergave.Getal(cel.Waarde)</td>
        }
        else
        {
            <td class="r @Weergave.PlaatsKlasse(cel.Plaats)">@Weergave.Getal(cel.Waarde)</td>
        }
    }
}

@if (online.IsLeeg)
{
    <h1>De stand</h1>
    <p>De stand staat nog niet online. Kijk na de volgende clubavond nog eens.</p>
}
else
{
    var week = Kalender.Week(stand.LaatsteAvond);

    <h1>Stand na week @week</h1>
    <p class="muted datum">@Weergave.Lang(stand.LaatsteAvond)</p>
    <p class="printen"><a class="btn secondary" asp-page="/Index" asp-page-handler="Pdf" target="_blank" rel="noopener">🖨 Stand printen</a></p>

    @if (online.Bericht.Length > 0)
    {
        <div class="p-card bericht">@online.Bericht</div>
    }

    <div class="p-card">
        <h2>Winnaars van de avond</h2>
        <ol class="p-winnaars">
            @foreach (var winnaar in stand.Winnaars)
            {
                <li><span class="medal @Weergave.PlaatsKlasse(winnaar.Plaats)">@winnaar.Plaats</span> @winnaar.Naam@(winnaar.IsInvaller ? " (invaller)" : string.Empty) <b>@Weergave.Getal(winnaar.Punten)</b></li>
            }
        </ol>
    </div>

    <div class="alleen-telefoon">
        <h2>Punten</h2>
        <table class="ptab">
            <thead><tr><th class="pl">#</th><th>Naam</th><th class="r">Totaal</th><th class="r">wk @week</th></tr></thead>
            <tbody>
                @foreach (var regel in stand.Punten)
                {
                    <tr>
                        <td class="pl @Weergave.PlaatsKlasse(regel.Plaats)">@regel.Plaats</td>
                        <td>@regel.Naam</td>
                        <td class="r"><b>@Weergave.Getal(regel.Totaal)</b></td>
                        @{ PuntenCel(regel.Cel(laatste)); }
                    </tr>
                }
            </tbody>
        </table>

        <h2>Pitten</h2>
        <table class="ptab">
            <thead><tr><th class="pl">#</th><th>Naam</th><th class="r">Pitten</th><th class="r">wk @week</th></tr></thead>
            <tbody>
                @foreach (var regel in stand.Pitten)
                {
                    var cel = regel.Cel(laatste);
                    <tr>
                        <td class="pl @Weergave.PlaatsKlasse(regel.Plaats)">@regel.Plaats</td>
                        <td>@regel.Naam</td>
                        <td class="r"><b>@Weergave.Getal(regel.Totaal)</b></td>
                        <td class="r">@(cel.IsLeeg ? string.Empty : Weergave.Getal(cel.Waarde))</td>
                    </tr>
                }
            </tbody>
        </table>
        <p class="muted klein">Op een computer ziet u alle weken van de maand.</p>
    </div>

    <div class="alleen-computer">
        <partial name="_StandTabellen" model="stand" />
    </div>

    <p class="muted klein bijgewerkt">Online gezet op @Weergave.Moment(online.OnlineSinds).</p>
}
